#!/bin/sh
# Uptime, load, memory and disk usage. Reads only.
set -u

# A view of the host that hides these files must fail, not return empty sections.
for f in /proc/uptime /proc/loadavg /proc/meminfo; do
    if [ ! -r "$f" ]; then
        echo "host view hidden: cannot read $f" >&2
        exit 3
    fi
done

echo "== uptime"
uptime 2>/dev/null || cat /proc/uptime

echo
echo "== load (1, 5, 15 minutes; running/total tasks)"
cat /proc/loadavg

echo
echo "== memory (MiB)"
if command -v free >/dev/null 2>&1; then
    free -m
else
    grep -E '^(MemTotal|MemAvailable|SwapTotal|SwapFree):' /proc/meminfo
fi

echo
echo "== disks"
if ! df -hP -x tmpfs -x devtmpfs -x overlay -x squashfs 2>/dev/null; then
    df -hP || {
        echo "host view hidden: df cannot read the mount table" >&2
        exit 3
    }
fi

#!/bin/sh
# Running and failed systemd services, and enabled timers. Reads only.
set -u

if ! command -v systemctl >/dev/null 2>&1; then
    echo "host view hidden: systemctl is not installed" >&2
    exit 3
fi
# `is-system-running` exits non-zero for "degraded", so judge its text, not its status.
state=$(systemctl is-system-running 2>/dev/null || :)
case "$state" in
    running | degraded | starting | stopping | maintenance | initializing) ;;
    *)
        echo "host view hidden: systemd does not answer ($state); the service bus is not reachable from here" >&2
        exit 3
        ;;
esac

echo "== running services"
systemctl list-units --type=service --state=running --no-legend --plain --no-pager || exit 3
echo
echo "== failed services"
systemctl list-units --type=service --state=failed --no-legend --plain --no-pager || exit 3
echo
echo "== timers"
systemctl list-timers --no-legend --no-pager || exit 3

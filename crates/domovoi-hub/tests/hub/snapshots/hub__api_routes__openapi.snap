    "/api/v1/conversations/{id}": {
      "delete": {
        "operationId": "delete_conversation",
        "parameters": [
          {
            "description": "Conversation id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "content": {
              "application/json": {

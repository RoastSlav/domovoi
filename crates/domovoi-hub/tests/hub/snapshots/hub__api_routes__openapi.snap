---
source: crates/domovoi-hub/tests/hub/api_routes.rs
expression: spec
---
{
  "components": {
    "schemas": {
      "AckDto": {
        "description": "One acknowledged publication finding.",
        "properties": {
          "acknowledged_at": {
            "description": "When, RFC 3339 UTC.",
            "type": "string"
          },
          "acknowledged_by": {
            "description": "Who acknowledged it.",
            "type": "string"
          },
          "finding_key": {
            "description": "The finding's stable key.",
            "type": "string"
          },
          "first_rule": {
            "description": "The first rule involved.",
            "type": "string"
          },
          "kind": {
            "description": "The finding's kind.",
            "type": "string"
          },
          "note": {
            "description": "What the review said.",
            "type": "string"
          },
          "resolution": {
            "description": "What the pair resolves to.",
            "type": [
              "string",
              "null"
            ]
          },
          "second_rule": {
            "description": "The second rule involved.",
            "type": "string"
          }
        },
        "required": [
          "finding_key",
          "kind",
          "first_rule",
          "second_rule",
          "note",
          "acknowledged_by",
          "acknowledged_at"
        ],
        "type": "object"
      },
      "AckRuleDto": {
        "description": "A known condition: incidents that match it stay in the history and never notify.",
        "properties": {
          "check": {
            "description": "The check the rule matches, for example `security.ssh_login`.",
            "type": "string"
          },
          "created_at": {
            "description": "When the rule was created; null for rules made before this was recorded.",
            "type": [
              "string",
              "null"
            ]
          },
          "created_by": {
            "description": "The username of the person who created the rule; null when unknown.",
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "description": "When the rule stops applying; null means it never expires.",
            "type": [
              "string",
              "null"
            ]
          },
          "host": {
            "description": "The host the rule is limited to, by name; null means every host. A host missing\nfrom the store shows as `unknown host` with its id, so the list still works.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Rule id.",
            "type": "string"
          },
          "note": {
            "description": "Why the condition is acceptable.",
            "type": "string"
          },
          "predicates": {
            "description": "Conditions, all of which must hold.",
            "items": {
              "$ref": "#/components/schemas/PredicateDto"
            },
            "type": "array"
          },
          "target_pattern": {
            "description": "Target pattern with `*` allowed at the ends; null means any target.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "check",
          "predicates",
          "note"
        ],
        "type": "object"
      },
      "AckRuleInput": {
        "description": "A new rule.",
        "properties": {
          "check": {
            "description": "The check to match, for example `security.ssh_login`.",
            "type": "string"
          },
          "expires_at": {
            "description": "The exact time the rule stops applying, as RFC 3339, such as `2026-12-01T10:00:00Z`.\nWhen present it is used instead of `expires_in_minutes`, so a rule can be restored\nwith its original expiry; an unparseable value is refused.",
            "type": [
              "string",
              "null"
            ]
          },
          "expires_in_minutes": {
            "description": "Minutes from now until the rule stops applying; null means it never expires.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "host": {
            "description": "Host by name; null matches every host.",
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "description": "Why the condition is acceptable, 1 to 500 characters.",
            "type": "string"
          },
          "predicates": {
            "description": "Conditions, all of which must hold; at most 10.",
            "items": {
              "$ref": "#/components/schemas/PredicateDto"
            },
            "type": "array"
          },
          "target_pattern": {
            "description": "Target pattern with `*` allowed at the ends; null matches any target.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "check",
          "predicates",
          "note"
        ],
        "type": "object"
      },
      "AckRulePatch": {
        "description": "The fields of a known condition that can change. Anything left out stays as it is.",
        "properties": {
          "expires_at": {
            "description": "The exact time the rule stops applying, as RFC 3339; null means it never expires.",
            "type": [
              "string",
              "null"
            ]
          },
          "expires_in_minutes": {
            "description": "Minutes from now until the rule stops applying. Ignored when `expires_at` is given.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "host": {
            "description": "Host by name; null makes the rule apply to every host.",
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "description": "Why the condition is acceptable, 1 to 500 characters.",
            "type": [
              "string",
              "null"
            ]
          },
          "predicates": {
            "description": "Replaces the conditions on the evidence; at most 10.",
            "items": {
              "$ref": "#/components/schemas/PredicateDto"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "target_pattern": {
            "description": "Target pattern with `*` allowed at the ends; null matches any target.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "AdvisoryDto": {
        "description": "An open advisory.",
        "properties": {
          "created_at": {
            "description": "When it was raised.",
            "type": "string"
          },
          "detail": {
            "description": "What to do.",
            "type": "string"
          },
          "host_id": {
            "description": "The host it is about, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Advisory id.",
            "type": "string"
          },
          "kind": {
            "description": "The kind, for example `stale_image`.",
            "type": "string"
          },
          "title": {
            "description": "One line.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "detail",
          "created_at"
        ],
        "type": "object"
      },
      "AnswerStepRequest": {
        "description": "Answering the question an operation waits on.",
        "properties": {
          "text": {
            "description": "The answer, 1 to 2000 characters after trimming. It reaches the model as data.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "ApproveStepRequest": {
        "description": "Approving an execution step.",
        "properties": {
          "confirm_text": {
            "description": "Required when the execution says `confirm_required`: the skill's name typed exactly.",
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "description": "A containment step only: the signed-in person's password, asked again.",
            "type": [
              "string",
              "null"
            ]
          },
          "plan_hash": {
            "description": "Required. The v2 plan hash shown on the execution, 64 hex characters.",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "unverified_acknowledged": {
            "description": "A containment step only: set when the person acknowledges that the helper's coverage\ncould not be verified. Without it that step is refused with `unverified_not_acknowledged`.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "plan_hash"
        ],
        "type": "object"
      },
      "AskRequest": {
        "description": "A follow-up question.",
        "properties": {
          "question": {
            "description": "The question, at most 1000 characters.",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "type": "object"
      },
      "AskResponse": {
        "description": "The answer to a follow-up question.",
        "properties": {
          "answer": {
            "description": "Plain text, at most 4000 characters.",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "type": "object"
      },
      "AttestationDto": {
        "description": "Where the attestation stands.",
        "properties": {
          "checked_at": {
            "description": "When the hub last recorded an outcome or asked.",
            "type": [
              "string",
              "null"
            ]
          },
          "helper_reason": {
            "description": "The token of a validly signed incomplete report. Display only.",
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnverifiedReasonDto",
                "description": "Why it is not verified, when it is not."
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "$ref": "#/components/schemas/AttestationStateDto",
            "description": "The verdict."
          },
          "unsigned_hint": {
            "description": "The unsigned token an agent relayed. Unverified: the agent can invent it.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "AttestationStateDto": {
        "description": "The verdict on the attestation.",
        "enum": [
          "verified",
          "stale",
          "unverified"
        ],
        "type": "string"
      },
      "AuditAnchorDto": {
        "description": "The anchor the chain starts from.",
        "properties": {
          "anchor_hash": {
            "description": "The anchor's own hash, hex.",
            "type": "string"
          },
          "install_id": {
            "description": "The install this log belongs to.",
            "type": "string"
          }
        },
        "required": [
          "install_id",
          "anchor_hash"
        ],
        "type": "object"
      },
      "AuditPageDto": {
        "description": "One page of audit entries, newest first.",
        "properties": {
          "items": {
            "description": "The entries.",
            "items": {
              "$ref": "#/components/schemas/AuditRowDto"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Pass as `cursor` for the next page; `null` on the last.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "AuditRowDto": {
        "description": "One audit entry with its chain position.",
        "properties": {
          "actor": {
            "description": "Who did it.",
            "type": "string"
          },
          "at": {
            "description": "When it was recorded, RFC 3339.",
            "type": "string"
          },
          "detail": {
            "description": "The entry's detail as compact JSON text, secrets removed, cut at 4096 bytes.",
            "type": "string"
          },
          "detail_truncated": {
            "description": "Whether `detail` was cut.",
            "type": "boolean"
          },
          "hash": {
            "description": "The entry's hash as 64 lower-case hex characters; `null` if the entry lost it.",
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "description": "What kind of entry it is.",
            "type": "string"
          },
          "seq": {
            "description": "The entry's sequence number.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "subject": {
            "description": "What it is about.",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "at",
          "actor",
          "kind",
          "subject",
          "detail",
          "detail_truncated"
        ],
        "type": "object"
      },
      "AuditVerificationDto": {
        "description": "The result of checking the audit log.",
        "properties": {
          "anchor": {
            "$ref": "#/components/schemas/AuditAnchorDto",
            "description": "The anchor the chain is judged against."
          },
          "chained": {
            "$ref": "#/components/schemas/ChainedHistoryDto",
            "description": "The chain's status."
          },
          "checked_at": {
            "description": "When the check finished, RFC 3339.",
            "type": "string"
          },
          "head": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/HeadDto",
                "description": "The newest stored entry; `null` before the first entry."
              },
              {
                "type": "null"
              }
            ]
          },
          "recent_limit": {
            "description": "How many of the newest entries a `recent` check covers.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "scope": {
            "description": "`recent` or `full`.",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "recent_limit",
          "checked_at",
          "chained",
          "anchor"
        ],
        "type": "object"
      },
      "AuthorizationDto": {
        "description": "Who authorized an execution: a person, or a policy permit.",
        "properties": {
          "channel": {
            "description": "Where a person approved: `web`, or `chat:<platform>`.",
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "description": "`human` or `policy`.",
            "type": "string"
          },
          "permit": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PolicyAllowDto",
                "description": "The permit, for a policy."
              },
              {
                "type": "null"
              }
            ]
          },
          "user": {
            "description": "The approving user, for a person: `user:<id>`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "AutonomyDto": {
        "description": "The autonomy switches.",
        "properties": {
          "paused": {
            "description": "Whether autonomy is paused.",
            "type": "boolean"
          },
          "paused_at": {
            "description": "When it last changed.",
            "type": [
              "string",
              "null"
            ]
          },
          "paused_by": {
            "description": "Who last changed the switch.",
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "description": "Why it was paused.",
            "type": [
              "string",
              "null"
            ]
          },
          "suspended_rules": {
            "description": "Rules whose breaker is open.",
            "items": {
              "$ref": "#/components/schemas/SuspendedRuleDto"
            },
            "type": "array"
          }
        },
        "required": [
          "paused",
          "suspended_rules"
        ],
        "type": "object"
      },
      "BlockDto": {
        "description": "One block the hub recorded.",
        "properties": {
          "applied_at": {
            "description": "When the helper applied the block.",
            "type": [
              "string",
              "null"
            ]
          },
          "assurance": {
            "description": "`verified` or `unverified`.",
            "type": "string"
          },
          "authorization": {
            "description": "`human` or `policy`.",
            "type": "string"
          },
          "block_id": {
            "description": "The block's id: the execution id of its apply.",
            "type": "string"
          },
          "bridge_gap": {
            "description": "Whether a bridged interface leaves a gap.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "created_at": {
            "description": "When the block was created.",
            "type": "string"
          },
          "deadline": {
            "description": "When a confirmed block ends.",
            "type": [
              "string",
              "null"
            ]
          },
          "existing_flows": {
            "description": "`cut`, `n/a` or `may_persist`.",
            "type": [
              "string",
              "null"
            ]
          },
          "failure_token": {
            "description": "The token of a refusal or failure.",
            "type": [
              "string",
              "null"
            ]
          },
          "host_id": {
            "description": "The host.",
            "type": "string"
          },
          "operation_id": {
            "description": "The operation the block belongs to.",
            "type": "string"
          },
          "phase": {
            "description": "`applying`, `applied`, `confirming`, `confirmed`, `rolling_back`, `rolled_back`,\n`expired`, `lost`, `not_run`, `failed` or `outcome_unknown`.",
            "type": "string"
          },
          "reason": {
            "description": "Why coverage could not be verified, on the unverified path.",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "description": "The canonical network.",
            "type": "string"
          },
          "step_id": {
            "description": "The step the block belongs to.",
            "type": "string"
          },
          "ttl_s": {
            "description": "The TTL the block has once confirmed, in seconds.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "unprotected_paths": {
            "description": "The paths the verified report did not cover, on the unverified path.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updated_at": {
            "description": "When the block last changed.",
            "type": "string"
          }
        },
        "required": [
          "block_id",
          "host_id",
          "operation_id",
          "step_id",
          "source",
          "ttl_s",
          "phase",
          "authorization",
          "assurance",
          "unprotected_paths",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "BudgetExtensionDto": {
        "description": "One limit to raise when resuming.",
        "properties": {
          "kind": {
            "description": "`model_turns`, `evidence_requests`, `executions`, `cycles`, `wall_time`, `tokens` or\n`cost`.",
            "type": "string"
          },
          "limit": {
            "description": "The new limit: seconds for `wall_time`, micro-units for `cost`, a count otherwise.\n1 to 10000 for a count, 1 to 10000000000 otherwise.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "limit"
        ],
        "type": "object"
      },
      "BudgetLimitsDto": {
        "description": "The limits of an operation; `null` means no limit.",
        "properties": {
          "cost_micros": {
            "description": "Model cost in millionths of a US dollar.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "cycles": {
            "description": "Investigation cycles.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence_requests": {
            "description": "Evidence requests.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "executions": {
            "description": "Executions.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "model_turns": {
            "description": "Model turns.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "tokens": {
            "description": "Model tokens.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "wall_seconds": {
            "description": "Wall-clock seconds.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "BudgetUsedDto": {
        "description": "What an operation has used so far.",
        "properties": {
          "cost_micros": {
            "description": "Model cost in millionths of a US dollar.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "evidence_requests": {
            "description": "Evidence requests.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "executions": {
            "description": "Executions.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "model_turns": {
            "description": "Model turns.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "tokens": {
            "description": "Model tokens.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "wall_seconds": {
            "description": "Wall-clock seconds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "model_turns",
          "evidence_requests",
          "executions",
          "wall_seconds",
          "tokens",
          "cost_micros"
        ],
        "type": "object"
      },
      "BudgetsDto": {
        "description": "An operation's limits and use.",
        "properties": {
          "limits": {
            "$ref": "#/components/schemas/BudgetLimitsDto",
            "description": "The limits."
          },
          "used": {
            "$ref": "#/components/schemas/BudgetUsedDto",
            "description": "The use."
          }
        },
        "required": [
          "limits",
          "used"
        ],
        "type": "object"
      },
      "CancelOperationRequest": {
        "description": "Cancelling an operation.",
        "properties": {
          "reason": {
            "description": "Why, at most 500 characters. Empty or missing records \"cancelled by a person\".",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "CancelResponse": {
        "description": "The answer's status after a stop.",
        "properties": {
          "status": {
            "description": "`cancelled` only when this call stopped it.",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "CapabilitiesDto": {
        "description": "One host's whole inventory, plus the ids the agent reported that the hub does not know.",
        "properties": {
          "entries": {
            "description": "One row per capability this hub knows.",
            "items": {
              "$ref": "#/components/schemas/CapabilityDto"
            },
            "type": "array"
          },
          "host": {
            "description": "The host's name.",
            "type": "string"
          },
          "unknown_contracts": {
            "description": "Ids the agent reported that no contract describes. Diagnostics only.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "host",
          "entries",
          "unknown_contracts"
        ],
        "type": "object"
      },
      "CapabilityDto": {
        "description": "One capability as this host sees it.",
        "properties": {
          "catalogue": {
            "$ref": "#/components/schemas/CatalogueDto",
            "description": "How much of the host's implementation list the hub has read."
          },
          "category": {
            "description": "Coarse family used for policy specificity.",
            "type": "string"
          },
          "contract": {
            "description": "Contract id, `<family>.<verb>`.",
            "type": "string"
          },
          "describe": {
            "description": "A short owner-facing sentence about the state.",
            "type": "string"
          },
          "effect": {
            "description": "The effect class the contract carries.",
            "type": "string"
          },
          "execution": {
            "description": "Where it executes.",
            "type": "string"
          },

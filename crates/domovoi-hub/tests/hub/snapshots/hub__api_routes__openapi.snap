              "kind": {
                "enum": [
                  "any"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Every capability of one effect class (`read`, `mutate`, `contain`, `destructive`).",
            "properties": {
              "effect": {
                "description": "The effect class.",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "effect"
                ],
                "type": "string"
              }
            },
            "required": [
              "effect",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Every capability of one category.",
            "properties": {
              "category": {
                "description": "The category.",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "category"
                ],
                "type": "string"
              }
            },
            "required": [
              "category",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "One contract.",
            "properties": {
              "contract": {
                "description": "The contract id.",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "contract"
                ],
                "type": "string"
              }
            },
            "required": [
              "contract",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "PolicyOverviewDto": {
        "description": "The policy at a glance.",
        "properties": {
          "active": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/VersionSummaryDto",
                "description": "The active version, if any was published."
              },
              {
                "type": "null"
              }
            ]
          },
          "draft": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DraftSummaryDto",
                "description": "The draft, if there is one."
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "description": "Standing notes.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "shadow": {
            "$ref": "#/components/schemas/ShadowStateDto",
            "description": "The shadow recorder."
          },
          "shadow_enabled": {
            "description": "Whether `[policy] shadow` is on.",
            "type": "boolean"
          },
          "time_window_zone": {
            "description": "The zone `time_window` conditions are read in; the UI must label it.",
            "type": "string"
          }
        },
        "required": [
          "shadow_enabled",
          "time_window_zone",
          "shadow",
          "notes"
        ],
        "type": "object"
      },
      "PolicyReportDto": {
        "description": "The publication review.",
        "properties": {
          "blocked": {
            "description": "Whether any finding blocks publication until acknowledged.",
            "type": "boolean"
          },
          "findings": {
            "description": "Every finding, worst first.",
            "items": {
              "$ref": "#/components/schemas/FindingDto"
            },
            "type": "array"
          }
        },
        "required": [
          "findings",
          "blocked"
        ],
        "type": "object"
      },
      "PredicateDto": {
        "description": "One condition on a signal's evidence. `value` is text, a number, `true` or `false`;\n`at_most` and `at_least` need a number, and `in_network` an address such as\n`192.168.1.20` or an address range such as `192.168.1.0/24`.",
        "properties": {
          "key": {
            "description": "Evidence key, for example `value` or `user`.",
            "type": "string"
          },
          "op": {
            "$ref": "#/components/schemas/PredicateOpDto",
            "description": "How the evidence compares with `value`."
          },
          "value": {
            "description": "What the evidence must compare with, as text.",
            "type": "string"
          }
        },
        "required": [
          "key",
          "op",
          "value"
        ],
        "type": "object"
      },
      "PredicateOpDto": {
        "description": "How a condition compares an evidence value with its `value`.",
        "enum": [
          "equals",
          "contains",
          "at_most",
          "at_least",
          "in_network"
        ],
        "type": "string"
      },
      "PreferencesDto": {
        "description": "A person's stored preferences. A person who never saved any gets the defaults.",
        "properties": {
          "presentation": {
            "$ref": "#/components/schemas/PresentationDto",
            "description": "How much detail pages show."
          },
          "updated_at": {
            "description": "When the preferences were last saved, as RFC 3339; null while none are saved.",
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "description": "The layout of the stored document; currently 1.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "presentation"
        ],
        "type": "object"
      },
      "PreferencesUpdateDto": {
        "description": "A change to the preferences. A group left out or null stays as it is; a group given\nreplaces the stored one as a whole.",
        "properties": {
          "presentation": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PresentationDto",
                "description": "The new presentation settings."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "PresentationDto": {
        "description": "How much detail pages show: one level for every page, and levels for single pages.",
        "properties": {
          "pages": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Levels for single pages, by page key (a lowercase letter, then lowercase letters,\ndigits, `-` and `_`, up to 32 characters; at most 32 pages). Each value is\n`detailed`, `standard` or `essential`.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "profile": {
            "description": "The level pages use unless they have their own: `detailed`, `standard` or `essential`.",
            "type": "string"
          }
        },
        "required": [
          "profile"
        ],
        "type": "object"
      },
      "PreviewDto": {
        "description": "What a candidate rule set would do.",
        "properties": {
          "base_number": {
            "description": "The active version number, 0 when none.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "blocking": {
            "description": "The finding keys the owner must acknowledge.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "locked_changes": {
            "description": "Locked prohibitions the change touches.",
            "items": {
              "$ref": "#/components/schemas/LockChangeDto"
            },
            "type": "array"
          },
          "notes": {
            "description": "Standing notes.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "preview_hash": {
            "description": "Echo this to save a locked change or to publish.",
            "type": "string"
          },
          "report": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PolicyReportDto",
                "description": "The publication review."
              },
              {
                "type": "null"
              }
            ]
          },
          "rules_hash": {
            "description": "Hash of the candidate rules.",
            "type": "string"
          },
          "simulation": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SimulationSummaryDto",
                "description": "What the change would do to recent recorded decisions."
              },
              {
                "type": "null"
              }
            ]
          },
          "validation": {
            "description": "Problems that stop the rules; when any, `report` is null.",
            "items": {
              "$ref": "#/components/schemas/ValidationDto"
            },
            "type": "array"
          }
        },
        "required": [
          "base_number",
          "rules_hash",
          "preview_hash",
          "validation",
          "blocking",
          "locked_changes",
          "notes"
        ],
        "type": "object"
      },
      "PreviewRequest": {
        "description": "Preview a candidate rule set.",
        "properties": {
          "base_revision": {
            "description": "What the candidate is measured against, which decides its `preview_hash`. `null` measures\nagainst the active version: the preview to publish. A draft revision measures against that\ndraft: the preview to save over it. The two hashes differ, so publish needs the `null` one.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "rules": {
            "description": "The candidate rules.",
            "items": {
              "$ref": "#/components/schemas/RuleDto"
            },
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "type": "object"
      },
      "ProfileDto": {
        "description": "What the hub knows about one machine, as its agent reported it.",
        "properties": {
          "collected_at": {
            "description": "When the collection started.",
            "type": "string"
          },
          "markdown": {
            "description": "The note text: the summary, then every tool output.",
            "type": "string"
          },
          "note": {
            "description": "The generated note carrying this profile, so the UI can link to it.",
            "type": [
              "string",
              "null"
            ]
          },
          "sections": {
            "description": "One entry per tool output, in the order the tools ran.",
            "items": {
              "$ref": "#/components/schemas/ProfileSectionDto"
            },
            "type": "array"
          }
        },
        "required": [
          "collected_at",
          "markdown",
          "sections"
        ],
        "type": "object"
      },
      "ProfileSectionDto": {
        "description": "One tool output in a host profile: its title and whether it answered.",
        "properties": {
          "ok": {
            "description": "Whether the tool answered; a failed one shows in the profile as a gap.",
            "type": "boolean"
          },
          "title": {
            "description": "What the tool was asked for, for example `Containers`.",
            "type": "string"
          }
        },
        "required": [
          "title",

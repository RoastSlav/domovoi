          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many wrong passwords"
          }
        },
        "summary": "Creates the draft or replaces it. Changing a locked prohibition needs the password and the\npreview hash of exactly these rules.",
        "tags": [
          "policy"
        ]
      }
    },

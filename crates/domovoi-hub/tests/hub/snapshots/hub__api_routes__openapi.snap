              "$ref": "#/components/schemas/LockChangeDto"
            },
            "type": "array"
          }
        },
        "required": [
          "draft",
          "locked_changes"
        ],
        "type": "object"
      },
      "DraftSummaryDto": {
        "description": "The header of the draft.",
        "properties": {
          "based_on": {
            "description": "The version number the draft was based on, when one was active.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "locked_count": {
            "description": "Locked prohibitions among them.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "revision": {
            "description": "The draft's revision; echo it to replace or discard the draft.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "rule_count": {
            "description": "Rules in the draft.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "shadow_count": {
            "description": "Shadow rules among them.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "updated_at": {
            "description": "When it was last saved.",
            "type": "string"
          },
          "updated_by": {
            "description": "Who saved it.",
            "type": "string"
          }
        },
        "required": [

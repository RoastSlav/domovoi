    "/api/v1/policy/shadow": {
      "get": {
        "operationId": "policy_shadow_list",
        "parameters": [
          {
            "description": "A host id.",
            "in": "query",
            "name": "host",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "A contract id.",
            "in": "query",
            "name": "contract",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`evaluated`, `unevaluable` or `skipped`.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "An enforced outcome word.",
            "in": "query",
            "name": "outcome",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only rows whose enforced and shadow outcomes differ.",
            "in": "query",
            "name": "differing",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "RFC 3339 lower bound of the recording time.",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "RFC 3339 upper bound of the recording time.",
            "in": "query",
            "name": "until",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The `next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size, 1 to 100. Default 25.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShadowPageDto"
                }
              }
            },
            "description": "One page"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A filter value does not parse"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          }
        },
        "summary": "Recorded shadow decisions, newest first.",
        "tags": [
          "policy"
        ]
      }
    },

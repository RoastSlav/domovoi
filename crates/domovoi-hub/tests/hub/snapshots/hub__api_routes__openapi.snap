          },
          "kind": {
            "description": "The stored journal kind string; unknown kinds pass through.",
            "type": "string"
          },
          "seq": {
            "description": "The row's global journal sequence number.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "state": {
            "description": "The new state the row records: an execution state name for `operation.execution`, an\noperation status name for `operation.status`; `null` otherwise.",
            "type": [
              "string",
              "null"
            ]
          },
          "step": {
            "description": "The step the row is about, when the payload names one.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "seq",
          "at",
          "kind"
        ],
        "type": "object"
      },

    "/api/v1/system/logs": {
      "get": {
        "operationId": "list_logs",
        "parameters": [
          {
            "description": "How many lines to return, 1 to 2000. Default 200.",
            "in": "query",
            "name": "lines",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The least severe level to return: `error`, `warn`, `info`, `debug` or `trace`.",
            "in": "query",
            "name": "level",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LogLineDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The recent log lines"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Logs are not captured"
          }
        },
        "summary": "The hub's recent log lines, oldest first, with secrets removed.",
        "tags": [
          "system"
        ]
      }
    },

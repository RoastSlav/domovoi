          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such host"
          }
        },
        "summary": "Counts for the navigation: incidents, approvals and offline hosts.",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/packages": {
      "get": {
        "operationId": "list_packages",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PackageDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The imported packages"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          }
        },
        "summary": "Every imported package.",
        "tags": [
          "packages"
        ]
      }
    },
    "/api/v1/packages/import": {
      "post": {
        "operationId": "import_package",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PackageImportForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageDto"
                }
              }
            },
            "description": "The same archive was already imported; nothing changed"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageDto"
                }
              }
            },
            "description": "Imported"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not exactly the two files `archive` and `signature`"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Packages are disabled, the store is full, or the name and version belong to another archive"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The archive is larger than the hub accepts"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The signature file, the signature, the key or the archive is not acceptable"
          }
        },
        "summary": "Imports a signed package: the archive and its detached signature file as one multipart\nform with the fields `archive` and `signature`. The hub checks the signature file, the\narchive's digest and the signing key, then stores the archive under its digest. It never\nopens the archive. No password is asked for: importing installs nothing.",
        "tags": [
          "packages"
        ]
      }
    },
    "/api/v1/packages/jobs": {
      "get": {
        "operationId": "list_package_jobs",
        "parameters": [
          {
            "description": "Only jobs with a target on this host.",
            "in": "query",
            "name": "host_id",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Only jobs for this package.",
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "`active` for jobs with an unfinished target, `finished` for the others.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Page size, 1 to 200.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "The `next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobPageDto"
                }
              }
            },
            "description": "A page of jobs"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "An unreadable filter"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          }
        },
        "summary": "Install jobs, newest first.",
        "tags": [
          "packages"
        ]
      },
      "post": {
        "operationId": "create_package_job",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallJobDto"
                }
              }
            },
            "description": "Created; the work runs in the background"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not one to sixteen distinct hosts, or an unreadable name or hash"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The password is missing or wrong, or the typed name is not the package's"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such package or host"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Packages are disabled, the plan changed, or a host already has a job in progress"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many wrong passwords"
          }
        },
        "summary": "Creates an install or uninstall job with one target per host. Asks for the password\nagain and for the package name typed out, and refuses a plan that changed since the owner\nlooked at it. A job is approved here and nowhere else.",
        "tags": [
          "packages"
        ]
      }
    },

                  "$ref": "#/components/schemas/DraftDetailDto"
                }
              }
            },
            "description": "The draft"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "There is no draft"
          }
        },
        "summary": "The draft with its rules.",
        "tags": [
          "policy"
        ]
      },
      "put": {
        "operationId": "policy_save_draft",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveDraftRequest"
              }

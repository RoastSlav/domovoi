              },
              "names": {
                "description": "The names.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "names",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "TestRequest": {
        "description": "Candidate values for a connection test; nothing is saved.",
        "properties": {
          "changes": {
            "description": "The same shape as a save; a secret left as `{ \"keep\": true }` uses the stored one.",
            "type": "object"
          },
          "password": {
            "description": "The admin's password. Required when the candidate changes a CLI model provider\n(`llm.*.cli`), because testing runs that program; saving it asks for the same.",
            "type": [
              "string",
              "null"
            ]
          },
          "slot": {
            "description": "Which provider to test or list models for: `\"primary\"` (the default) or\n`\"secondary\"`. Other tests ignore it.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "TestResultDto": {
        "description": "The result of a connection test.",
        "properties": {
          "latency_ms": {
            "description": "How long it took, in milliseconds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "message": {
            "description": "What happened, in one line.",
            "type": "string"
          },
          "ok": {
            "description": "Whether it worked.",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "message",
          "latency_ms"
        ],
        "type": "object"
      },
      "TimelineEntryDto": {
        "description": "One timeline line.",
        "properties": {
          "at": {
            "description": "When.",
            "type": "string"
          },
          "kind": {
            "description": "What kind, for example `incident.opened` or `triage.report`.",
            "type": "string"
          },
          "summary": {
            "description": "One line.",
            "type": "string"
          }
        },
        "required": [
          "at",
          "kind",
          "summary"
        ],
        "type": "object"
      },
      "ToolUsageDto": {
        "description": "One skill or tool used while triaging or answering a follow-up.",
        "properties": {
          "calls": {
            "description": "How many times it was called.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "failures": {
            "description": "How many of those calls failed.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "description": "`tool` or `skill`.",
            "type": "string"
          },
          "last_used": {
            "description": "When it was last called.",
            "type": "string"
          },
          "name": {
            "description": "The tool name, or the skill name for a read skill.",
            "type": "string"
          },
          "refused": {
            "description": "How many of those calls were not run because the tool-call budget was spent.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "kind",
          "calls",
          "failures",
          "refused",
          "last_used"
        ],
        "type": "object"
      },
      "TraceEdgeDto": {
        "description": "A link between two steps.",
        "properties": {
          "from": {
            "description": "The dependent step.",
            "type": "string"
          },
          "kind": {
            "description": "`depends_on`, `caused_by`, `verifies`, `retry_of` or `answers`.",
            "type": "string"
          },
          "to": {
            "description": "The earlier step it points at.",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "kind"
        ],
        "type": "object"
      },
      "TraceOperationDto": {
        "description": "The operation a trace is about.",
        "properties": {
          "budgets": {
            "$ref": "#/components/schemas/BudgetsDto",
            "description": "Limits and use."
          },
          "created_at": {
            "description": "When it was created.",
            "type": "string"
          },
          "cycle": {
            "description": "The current cycle.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "ended_at": {
            "description": "When it ended.",
            "type": [
              "string",
              "null"
            ]
          },
          "goal": {
            "description": "What it is trying to achieve.",
            "type": "string"
          },
          "id": {
            "description": "Operation id.",
            "type": "string"
          },
          "incidents": {
            "description": "The incidents it is about.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "kind": {
            "description": "The kind, for example `investigate`.",
            "type": "string"
          },
          "parent": {
            "description": "The operation it was started from.",
            "type": [
              "string",
              "null"
            ]
          },
          "pause_reason": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PauseReasonDto",
                "description": "Why it is paused, when it is."
              },
              {
                "type": "null"
              }
            ]
          },
          "pinned": {
            "description": "What it may act on.",
            "items": {
              "$ref": "#/components/schemas/PinnedSubjectDto"
            },
            "type": "array"
          },
          "started_at": {
            "description": "When it started.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "The status name, for example `waiting_approval`.",
            "type": "string"
          },
          "waiting_for": {
            "description": "What it waits for: `approval`, `user`, `agent` or `timer`.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "kind",
          "goal",
          "status",
          "waiting_for",
          "cycle",
          "budgets",
          "pinned",
          "incidents",
          "created_at"
        ],
        "type": "object"
      },
      "TraceRefDto": {
        "description": "A link from a step to something stored elsewhere.",
        "properties": {
          "id": {
            "description": "Its id.",
            "type": "string"
          },
          "kind": {
            "description": "What it points at, for example `execution`.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "type": "object"
      },
      "TraceStepDto": {
        "description": "One step as the timeline shows it. Never carries output, intent or approval details.",
        "properties": {
          "cycle": {
            "description": "The cycle it belongs to.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "ended_at": {
            "description": "When it ended.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Step id.",
            "type": "string"
          },
          "kind": {
            "description": "The step kind, for example `reasoning_turn`.",
            "type": "string"
          },
          "outcome": {
            "description": "The outcome so far, for example `running` or `succeeded`.",
            "type": "string"
          },
          "parent": {
            "description": "The step it follows from.",
            "type": [
              "string",
              "null"
            ]
          },
          "phase": {
            "description": "A short label of the phase of work.",
            "type": "string"
          },
          "refs": {
            "description": "What it links to.",
            "items": {
              "$ref": "#/components/schemas/TraceRefDto"
            },
            "type": "array"
          },
          "started_at": {
            "description": "When it started.",
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "description": "One line on what it came to.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "phase",
          "cycle",
          "outcome",
          "refs"
        ],
        "type": "object"
      },
      "TriageSettings": {
        "description": "Triage limits.",
        "properties": {
          "concurrency": {
            "description": "Runs at the same time.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "enabled": {
            "description": "Whether new incidents are triaged.",
            "type": "boolean"
          },
          "monthly_budget_usd": {
            "description": "Monthly spending cap in US dollars, if set.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "per_hour_runs": {
            "description": "Runs per hour at most.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "reserved_for_incidents": {
            "description": "Of those runs, how many the hour keeps free for incidents: questions and\nchat may not use these last runs of the hour.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "concurrency",
          "per_hour_runs",
          "reserved_for_incidents"
        ],
        "type": "object"
      },
      "TriageStateDto": {
        "description": "How triage went for an incident.",
        "properties": {
          "kind": {
            "description": "`report`, `cached`, `skipped` or `failed`.",
            "type": "string"
          },
          "reason": {
            "description": "Why it was skipped or failed.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "TurnDto": {
        "description": "One question and its answer of the conversation the model still remembers.",
        "properties": {
          "answer": {
            "description": "What the model answered.",
            "type": "string"
          },
          "asked_by": {
            "description": "Who asked, as `user:` and its user id.",
            "type": "string"
          },
          "at": {
            "description": "When the answer was recorded, RFC 3339.",
            "type": "string"
          },
          "question": {
            "description": "What the operator asked.",
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer",
          "asked_by",
          "at"
        ],
        "type": "object"
      },
      "TurnInProgressDto": {
        "description": "The answer being written.",
        "properties": {
          "message": {
            "description": "The assistant message.",
            "type": "string"
          },
          "turn": {
            "description": "The turn.",
            "type": "string"
          }
        },
        "required": [
          "turn",
          "message"
        ],
        "type": "object"
      },
      "UnpinKeyRequest": {
        "description": "The owner's request to unpin the helper key.",
        "properties": {
          "password": {
            "description": "The account password, asked for again.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UnverifiedReasonDto": {
        "description": "Why the helper's attestation is not verified: the closed set the wire and the gate use.",
        "enum": [
          "key_not_pinned",
          "key_mismatch",
          "attestation_missing",
          "attestation_stale",
          "signature_invalid",
          "report_incomplete",
          "generation_regressed",
          "path_uncovered",
          "confirmation_stale"
        ],
        "type": "string"
      },
      "UpdateDto": {
        "description": "The newest release this hub knows about, with commands ready to copy.",
        "properties": {
          "agent_command": {
            "description": "Reinstalls an agent and restarts its service.",
            "type": [
              "string",
              "null"
            ]
          },
          "checked_at": {
            "description": "When this hub last checked.",
            "type": [
              "string",
              "null"
            ]
          },
          "current": {
            "description": "The version this hub runs.",
            "type": "string"
          },
          "docker_command": {
            "description": "Pulls and recreates a container deployment.",
            "type": [
              "string",
              "null"
            ]
          },
          "hub_command": {
            "description": "Reinstalls the hub and restarts its service.",
            "type": [
              "string",
              "null"
            ]
          },
          "latest": {
            "description": "The release's tag, for example `v0.5.0`; `None` until the first check succeeds.",
            "type": [
              "string",
              "null"
            ]
          },
          "newer": {
            "description": "Whether `latest` is newer than `current`.",
            "type": "boolean"
          },
          "notes": {
            "description": "The release notes, cut to 4000 characters.",
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "description": "When the release was published.",
            "type": [
              "string",
              "null"
            ]
          },
          "upgrade_command": {
            "description": "Replaces the hub's binary in place and restarts its service. `None` when the hub\nruns in a container, where the image is what changes.",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "description": "The release's page on GitHub.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "current",
          "newer"
        ],
        "type": "object"
      },
      "UsageSettings": {
        "description": "Model usage this calendar month (UTC).",
        "properties": {
          "cost_usd": {
            "description": "Cost in US dollars, as far as prices are configured.",
            "format": "double",
            "type": "number"
          },
          "tokens_in": {
            "description": "Prompt tokens.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "tokens_out": {
            "description": "Generated tokens.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "tokens_in",
          "tokens_out",
          "cost_usd"
        ],
        "type": "object"
      },
      "UserDto": {
        "description": "The logged-in user.",
        "properties": {
          "id": {
            "description": "User id.",
            "type": "string"
          },
          "username": {
            "description": "Login name.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ],
        "type": "object"
      },
      "ValidationDto": {
        "description": "One problem that stops the rules from being saved or published.",
        "properties": {
          "message": {
            "description": "What is wrong.",
            "type": "string"
          },
          "rule": {
            "description": "The rule it is about, if any.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "VerifiedDto": {
        "description": "The verified effective set. Present only while the attestation is verified and fresh.",
        "properties": {
          "age_seconds": {
            "description": "Seconds since then.",
            "format": "int64",
            "type": "integer"
          },
          "boot_id": {
            "description": "The boot the report was made in.",
            "type": "string"
          },
          "cidrs": {
            "description": "The configured management networks.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "computed_at": {
            "description": "When the helper computed the report. Display only.",
            "type": "string"
          },
          "config_hash": {
            "description": "Hash of the effective configuration.",
            "type": "string"
          },
          "fresh": {
            "description": "Whether the report is within the freshness window.",
            "type": "boolean"
          },
          "generation": {
            "description": "The report generation.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "hub_addrs": {
            "description": "The hub addresses the helper found.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "link_peers": {
            "description": "The link peers the helper found, as `address:port`.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "max_active": {
            "description": "How many containments may be active; zero allows none.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "max_ttl_s": {
            "description": "The longest a containment may last, in seconds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "nonce_issued_at": {
            "description": "When the hub issued the nonce the report answers.",
            "type": "string"
          },
          "protected_containers": {
            "description": "The protected container names.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "protected_units": {
            "description": "The protected unit names.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "route_state_hash": {
            "description": "Hash of the observed route state.",
            "type": "string"
          }
        },
        "required": [
          "generation",
          "boot_id",
          "config_hash",
          "route_state_hash",
          "nonce_issued_at",
          "age_seconds",
          "fresh",
          "computed_at",
          "max_ttl_s",
          "max_active",
          "cidrs",
          "protected_units",
          "protected_containers",
          "hub_addrs",
          "link_peers"
        ],
        "type": "object"
      },
      "VerifyDto": {
        "description": "How the hub checks that a write skill worked.",
        "properties": {
          "delay_secs": {
            "description": "How long to wait before re-running it, in seconds.",
            "format": "int64",
            "type": "integer"
          },
          "recheck": {
            "description": "Whether the hub re-runs the originating check.",
            "type": "boolean"
          }
        },
        "required": [
          "recheck",
          "delay_secs"
        ],
        "type": "object"
      },
      "VersionDetailDto": {
        "description": "One published version with its rules and acknowledgements.",
        "properties": {
          "acknowledgements": {
            "description": "The findings acknowledged when it was published.",
            "items": {
              "$ref": "#/components/schemas/AckDto"
            },
            "type": "array"
          },
          "rules": {
            "description": "Its rules.",
            "items": {
              "$ref": "#/components/schemas/RuleDto"
            },
            "type": "array"
          },
          "summary": {
            "$ref": "#/components/schemas/VersionSummaryDto",
            "description": "The version's header."
          }
        },
        "required": [
          "summary",
          "rules",
          "acknowledgements"
        ],
        "type": "object"
      },
      "VersionPageDto": {
        "description": "A page of published versions, newest first.",
        "properties": {
          "items": {
            "description": "The versions.",
            "items": {
              "$ref": "#/components/schemas/VersionSummaryDto"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Pass as `cursor` for the next page; absent on the last.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "VersionSummaryDto": {
        "description": "The header of one policy version or draft.",
        "properties": {
          "locked_count": {
            "description": "Locked prohibitions among them.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "number": {
            "description": "The version number.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "published_at": {
            "description": "When it was published, RFC 3339 UTC.",
            "type": "string"
          },
          "published_by": {
            "description": "Who published it.",
            "type": "string"
          },
          "rule_count": {
            "description": "Rules in the version.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "rules_hash": {
            "description": "Hash of the rules.",
            "type": "string"
          },
          "shadow_count": {
            "description": "Shadow rules among them.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "number",
          "published_at",
          "published_by",
          "rule_count",
          "locked_count",
          "shadow_count",
          "rules_hash"
        ],
        "type": "object"
      },
      "WebhookSettings": {
        "description": "One inbound webhook.",
        "properties": {
          "auth": {
            "description": "`hmac` or `bearer`.",
            "type": "string"
          },
          "default_host": {
            "description": "The host used when the payload names none.",
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "description": "`generic`, `alertmanager` or `uptime_kuma`.",
            "type": "string"
          },
          "name": {
            "description": "The name in its URL.",
            "type": "string"
          },
          "secret": {
            "description": "`[set]` or `[unset]`.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "auth",
          "secret"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "domovoi_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The hub's JSON API. Log in with `POST /api/v1/auth/login`; the session is a cookie. Send the session's `csrf_token` as `X-CSRF-Token` on every unsafe request.",
    "license": {
      "identifier": "PolyForm-Noncommercial-1.0.0",
      "name": "PolyForm-Noncommercial-1.0.0"
    },
    "title": "Domovoi hub API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ack-rules": {
      "get": {
        "operationId": "list_ack_rules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AckRuleDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every rule, soonest expiry first; rules that never expire come last"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          }
        },
        "summary": "Every rule, expired ones included. Rules that never expire come last.",
        "tags": [
          "incidents"
        ]
      },
      "post": {
        "operationId": "create_ack_rule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AckRuleInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AckRuleDto"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid rule"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"

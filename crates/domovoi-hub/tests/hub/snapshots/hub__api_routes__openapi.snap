---
source: crates/domovoi-hub/tests/hub/api_routes.rs
expression: spec
---
{
  "components": {
    "schemas": {
      "AckRuleDto": {
        "description": "A known condition: incidents that match it stay in the history and never notify.",
        "properties": {
          "check": {
            "description": "The check the rule matches, for example `security.ssh_login`.",
            "type": "string"
          },
          "expires_at": {
            "description": "When the rule stops applying; null means it never expires.",
            "type": [
              "string",
              "null"
            ]
          },
          "host": {
            "description": "The host the rule is limited to, by name; null means every host. A host missing\nfrom the store shows as `unknown host` with its id, so the list still works.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Rule id.",
            "type": "string"
          },
          "note": {
            "description": "Why the condition is acceptable.",
            "type": "string"
          },
          "predicates": {
            "description": "Conditions, all of which must hold.",
            "items": {
              "$ref": "#/components/schemas/PredicateDto"
            },
            "type": "array"
          },
          "target_pattern": {
            "description": "Target pattern with `*` allowed at the ends; null means any target.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "check",
          "predicates",
          "note"
        ],
        "type": "object"
      },
      "AckRuleInput": {
        "description": "A new rule.",
        "properties": {
          "check": {
            "description": "The check to match, for example `security.ssh_login`.",
            "type": "string"
          },
          "expires_in_minutes": {
            "description": "Minutes from now until the rule stops applying; null means it never expires.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "host": {
            "description": "Host by name; null matches every host.",
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "description": "Why the condition is acceptable, 1 to 500 characters.",
            "type": "string"
          },
          "predicates": {
            "description": "Conditions, all of which must hold; at most 10.",
            "items": {
              "$ref": "#/components/schemas/PredicateDto"
            },
            "type": "array"
          },
          "target_pattern": {
            "description": "Target pattern with `*` allowed at the ends; null matches any target.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "check",
          "predicates",
          "note"
        ],
        "type": "object"
      },
      "ActionDto": {
        "description": "An action.",
        "properties": {
          "approved_by": {
            "description": "Who approved it, if anyone.",
            "type": [
              "string",
              "null"
            ]
          },
          "args": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Arguments by parameter name.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "created_at": {
            "description": "When it was proposed.",
            "type": "string"
          },
          "expires_at": {
            "description": "When the approval window closes.",
            "type": "string"
          },
          "host_id": {
            "description": "The host it runs on.",
            "type": "string"
          },
          "id": {
            "description": "Action id.",
            "type": "string"
          },
          "incident_id": {
            "description": "The incident it is for.",
            "type": "string"
          },
          "proposed_by": {
            "description": "Who proposed it, for example `system:triage`.",
            "type": "string"
          },
          "reason": {
            "description": "Why it was rejected or failed.",
            "type": [
              "string",
              "null"
            ]
          },
          "risk": {
            "description": "`read`, `write` or `destructive`.",
            "type": "string"
          },
          "skill": {
            "description": "Skill name.",
            "type": "string"
          },
          "status": {
            "description": "The status name, for example `proposed` or `verified`.",
            "type": "string"
          },
          "updated_at": {
            "description": "When it last changed.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "incident_id",
          "host_id",
          "skill",
          "risk",
          "args",
          "status",
          "proposed_by",
          "expires_at",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "ActionPage": {
        "description": "One page of actions, newest first.",
        "properties": {
          "items": {
            "description": "The actions.",
            "items": {
              "$ref": "#/components/schemas/ActionDto"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Pass as `cursor` for the next page; absent on the last.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "AdvisoryDto": {
        "description": "An open advisory.",
        "properties": {
          "created_at": {
            "description": "When it was raised.",
            "type": "string"
          },
          "detail": {
            "description": "What to do.",
            "type": "string"
          },
          "host_id": {
            "description": "The host it is about, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Advisory id.",
            "type": "string"
          },
          "kind": {
            "description": "The kind, for example `stale_image`.",
            "type": "string"
          },
          "title": {
            "description": "One line.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "detail",
          "created_at"
        ],
        "type": "object"
      },
      "ApproveRequest": {
        "description": "Approving an action.",
        "properties": {
          "confirm_text": {
            "description": "For destructive skills: the skill's name typed exactly, as confirmation.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "AskRequest": {
        "description": "A follow-up question.",
        "properties": {
          "question": {
            "description": "The question, at most 1000 characters.",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "type": "object"
      },
      "AskResponse": {
        "description": "The answer to a follow-up question.",
        "properties": {
          "answer": {
            "description": "Plain text, at most 4000 characters.",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "type": "object"
      },
      "CardDto": {
        "description": "The incident's chat card, as it would be posted.",
        "properties": {
          "badge": {
            "description": "A verdict (`ACTION_NEEDED`, `MONITOR`, `EXPECTED` or `FIXED`) or, before triage, a\nseverity (`info`, `warning` or `critical`).",
            "type": "string"
          },
          "bullets": {
            "description": "Key facts.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "details": {
            "description": "Summary, cause and details, if triage ran.",
            "type": [
              "string",
              "null"
            ]
          },
          "headline": {
            "description": "One line.",
            "type": "string"
          },
          "next_step": {
            "description": "The next step, if triage gave one.",
            "type": [
              "string",
              "null"
            ]
          },
          "resolved": {
            "description": "Whether the incident resolved.",
            "type": "boolean"
          }
        },
        "required": [
          "badge",
          "headline",
          "bullets",
          "resolved"
        ],
        "type": "object"
      },
      "ChatRequest": {
        "description": "A general question, the host it is about and the conversation so far.",
        "properties": {
          "history": {
            "description": "The earlier turns, oldest first.",
            "items": {
              "$ref": "#/components/schemas/ChatTurnDto"
            },
            "type": "array"
          },
          "host": {
            "description": "The host to look at; absent or `null` asks about every host.",
            "type": [
              "string",
              "null"
            ]
          },
          "question": {
            "description": "The question to answer.",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "type": "object"
      },
      "ChatResponse": {
        "description": "The model's answer.",
        "properties": {
          "answer": {
            "description": "The answer, in Markdown.",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "type": "object"
      },
      "ChatTurnDto": {
        "description": "One earlier turn of the chat.",
        "properties": {
          "role": {
            "description": "Who said it: `user` or `assistant`.",
            "type": "string"
          },
          "text": {
            "description": "What was said.",
            "type": "string"
          }
        },
        "required": [
          "role",
          "text"
        ],
        "type": "object"
      },
      "CheckSettingsDto": {
        "description": "One check's settings: on or off, interval, thresholds.",
        "properties": {
          "enabled": {
            "description": "Whether the check runs; `None` keeps the agent's value.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "interval_seconds": {
            "description": "How often, in seconds; `None` keeps the agent's value.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "thresholds": {
            "description": "Thresholds merged over the agent's.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "DigestPreview": {
        "description": "The daily digest as it would be sent now.",
        "properties": {
          "date": {
            "description": "The day it is for.",
            "type": "string"
          },
          "markdown": {
            "description": "The rendered Markdown.",
            "type": "string"
          }
        },
        "required": [
          "date",
          "markdown"
        ],
        "type": "object"
      },
      "DiscordSettings": {
        "description": "Discord.",
        "properties": {
          "allowed_user_ids": {
            "description": "Discord user ids allowed to press buttons.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "bot_token": {
            "description": "`[set]` or `[unset]`.",
            "type": "string"
          },
          "channel_id": {
            "description": "The channel cards go to.",
            "type": "string"
          },
          "enabled": {
            "description": "Whether the bot runs.",
            "type": "boolean"
          },
          "webhook_url": {
            "description": "`[set]` or `[unset]`.",
            "type": "string"
          }
        },
        "required": [
          "enabled",
          "channel_id",
          "allowed_user_ids",
          "bot_token",
          "webhook_url"
        ],
        "type": "object"
      },
      "DismissRequest": {
        "description": "Dismissing an incident as a known condition.",
        "properties": {
          "ignore_for_minutes": {
            "description": "Minutes to keep the check quiet, 1 to 525600; 0 means always; null dismisses\nwithout creating a rule, so the check alerts again.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "reason": {
            "description": "Why this is not a real problem, 1 to 500 characters.",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "EditableSettings": {
        "description": "The settings as the UI edits them.",
        "properties": {
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Where each field some layer set comes from: `ui`, `file` or `env:<VAR>`. A field\nnot listed uses its default. An entry for an array or a secret covers everything\nunder it. Fields from `file` or `env:` are locked in the UI.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "issues": {
            "description": "Problems with the current settings, each with its path.",
            "items": {
              "$ref": "#/components/schemas/IssueDto"
            },
            "type": "array"
          },
          "last_apply": {
            "description": "How the last apply went: `{ ok, at, message? }`.",
            "type": [
              "object",
              "null"
            ]
          },
          "revision": {
            "description": "The revision a save must name.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "values": {
            "description": "The merged values, shaped like `hub.toml`; every secret that has a value is\n`\"[set]\"`, and a missing one is absent.",
            "type": "object"
          }
        },
        "required": [
          "revision",
          "values",
          "fields",
          "issues"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "The body of every error response.",
        "properties": {
          "error": {
            "description": "A stable machine-readable code, for example `not_found`.",
            "type": "string"
          },
          "issues": {
            "description": "For `invalid`: every problem, each with the settings path it is about.",
            "items": {
              "$ref": "#/components/schemas/IssueDto"
            },
            "type": "array"
          },
          "message": {
            "description": "One line for people.",
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "type": "object"
      },
      "EvidenceDto": {
        "description": "One piece of evidence in a report.",
        "properties": {
          "label": {
            "description": "What it shows.",
            "type": "string"
          },
          "source": {
            "description": "Where it came from.",
            "type": "string"
          },
          "value": {
            "description": "The value.",
            "type": "string"
          }
        },
        "required": [
          "label",
          "value",
          "source"
        ],
        "type": "object"
      },
      "FactDto": {
        "description": "One digest fact about a host.",
        "properties": {
          "key": {
            "description": "Stable key, for example `zfs.tank.used_pct`.",
            "type": "string"
          },
          "label": {
            "description": "Label for people.",
            "type": "string"
          },
          "observed_at": {
            "description": "When it was observed.",
            "type": "string"
          },
          "unit": {
            "description": "Unit, for example `%`.",
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "description": "The value as text.",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "value",
          "observed_at"
        ],
        "type": "object"
      },
      "FollowUpsDto": {
        "description": "The follow-up conversation the model still remembers for an incident, oldest first.",
        "properties": {
          "turns": {
            "description": "The remembered questions and answers; empty when there are none or after a clear.",
            "items": {
              "$ref": "#/components/schemas/TurnDto"
            },
            "type": "array"
          }
        },
        "required": [
          "turns"
        ],
        "type": "object"
      },
      "HeartbeatSettings": {
        "description": "The dead man's switch.",
        "properties": {
          "configured": {
            "description": "Whether a heartbeat URL is configured.",
            "type": "boolean"
          },
          "failing": {
            "description": "Whether the heartbeat-missing advisory is open.",
            "type": "boolean"
          },
          "interval": {
            "description": "How often it is pinged, if configured.",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "description": "`[set]` or `[unset]`.",
            "type": "string"
          }
        },
        "required": [
          "configured",
          "url",
          "failing"
        ],
        "type": "object"
      },
      "HostCheckDto": {
        "description": "One check on a host.",
        "properties": {
          "key": {
            "description": "The check key.",
            "type": "string"
          },
          "overrides": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CheckSettingsDto",
                "description": "What the hub overrides."
              },
              {
                "type": "null"
              }
            ]
          },
          "reported": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CheckSettingsDto",
                "description": "What the agent's own config sets, while it is connected."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key"
        ],
        "type": "object"
      },
      "HostChecksDto": {
        "description": "A host's checks.",
        "properties": {
          "checks": {
            "description": "Every check the agent reported or the hub overrides, by key.",
            "items": {
              "$ref": "#/components/schemas/HostCheckDto"
            },
            "type": "array"
          },
          "connected": {
            "description": "Whether the agent is connected.",
            "type": "boolean"
          }
        },
        "required": [
          "connected",
          "checks"
        ],
        "type": "object"
      },
      "HostChecksSaved": {
        "description": "Whether the agent got the change now.",
        "properties": {
          "delivered": {
            "description": "True when sent to the connected agent; false when it gets them on reconnect.",
            "type": "boolean"
          }
        },
        "required": [
          "delivered"
        ],
        "type": "object"
      },
      "HostChecksUpdate": {
        "description": "New overrides for a host's checks, replacing the previous ones.",
        "properties": {
          "overrides": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckSettingsDto"
            },
            "description": "Overrides by check key.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "overrides"
        ],
        "type": "object"
      },
      "HostDetailDto": {
        "description": "A host with its latest digest facts.",
        "properties": {
          "facts": {
            "description": "The latest value of each fact seen in the last 24 hours, sorted by key.",
            "items": {
              "$ref": "#/components/schemas/FactDto"
            },
            "type": "array"
          },
          "host": {
            "$ref": "#/components/schemas/HostDto",
            "description": "The host and its agent."
          }
        },
        "required": [
          "host",
          "facts"
        ],
        "type": "object"
      },
      "HostDockerDto": {
        "description": "A host's container runtime.",
        "properties": {
          "available": {
            "description": "Whether an engine answered on the host, so it can be switched on.",
            "type": "boolean"
          },
          "choice": {
            "description": "The hub's saved choice; absent when the agent decides.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "connected": {
            "description": "Whether the agent is connected. Nothing below is known while it is not.",
            "type": "boolean"
          },
          "enabled": {
            "description": "Whether the container checks and tools are in use on the host now.",
            "type": "boolean"
          },
          "endpoint": {
            "description": "The endpoint in use, or the one that failed; empty when there was none.",
            "type": "string"
          },
          "engine": {
            "description": "The engine found, such as `Docker` or `Podman`; empty when none.",
            "type": "string"
          },
          "locked": {
            "description": "Whether the agent's own config fixes the setting, so the hub cannot change it.",
            "type": "boolean"
          },
          "problem": {
            "description": "Why no engine can be used, in a sentence.",
            "type": [
              "string",
              "null"
            ]
          },
          "reported": {
            "description": "Whether the agent reports its container runtime. False for an agent too old to.",
            "type": "boolean"
          }
        },
        "required": [
          "connected",
          "reported",
          "engine",
          "endpoint",
          "available",
          "locked",
          "enabled"
        ],
        "type": "object"
      },
      "HostDockerSaved": {
        "description": "Whether the agent got the change now.",
        "properties": {
          "delivered": {
            "description": "True when sent to the connected agent; false when it gets it on reconnect.",
            "type": "boolean"
          }
        },
        "required": [
          "delivered"
        ],
        "type": "object"
      },
      "HostDockerUpdate": {
        "description": "The hub's choice for a host's container runtime.",
        "properties": {
          "enabled": {
            "description": "`true` or `false` switches the runtime on or off; `null` leaves it to the agent.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "HostDto": {
        "description": "A host and its agent's presence.",
        "properties": {
          "agent_enrolled": {
            "description": "Whether the host has an enrolled, not revoked agent. The hub loses sight of agents\nwhen it restarts, so this is what tells the UI an agent exists at all.",
            "type": "boolean"
          },
          "connected": {
            "description": "Whether the agent is connected now.",
            "type": "boolean"
          },
          "connected_since": {
            "description": "Since when it is connected.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Host id.",
            "type": "string"
          },
          "kind": {
            "description": "`agent`, `container_agent` or `external`.",
            "type": "string"
          },
          "last_seen": {
            "description": "When it was last seen, while disconnected.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "Host name.",
            "type": "string"
          },
          "open_incidents": {
            "description": "Incidents not yet resolved (pending, open, acked or muted), counted up to 200.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "outdated": {
            "description": "Whether the connected agent is older than the hub.",
            "type": "boolean"
          },
          "refused": {
            "description": "Why the host's agent was refused at its last handshake, for example\n`agent 0.0.1 is older than the minimum 0.0.5; update it`. `None` when the agent\nconnected, or was never refused.",
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "description": "The agent's version, while connected.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "connected",
          "agent_enrolled",
          "outdated",
          "open_incidents"
        ],
        "type": "object"
      },
      "HubSettings": {
        "description": "The hub's identity.",
        "properties": {
          "bind": {
            "description": "Where the web UI listens.",
            "type": "string"
          },
          "name": {
            "description": "The hub's name.",
            "type": "string"
          },
          "public_url": {
            "description": "The URL people open, if set.",
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "description": "The time zone for quiet hours and the digest.",
            "type": "string"
          },
          "trusted_proxies": {
            "description": "Proxies whose forwarded headers are trusted.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "timezone",
          "bind",
          "trusted_proxies"
        ],
        "type": "object"

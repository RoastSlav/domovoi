          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestResultDto"
                }
              }
            },
            "description": "Tried"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid candidate"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A CLI candidate needs the password"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "More than 10 tests a minute"
          }
        },
        "summary": "One GET of the candidate heartbeat URL.",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/settings/test/llm": {
      "post": {
        "operationId": "test_llm",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestResultDto"
                }
              }
            },
            "description": "Tried"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid candidate"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A CLI candidate needs the password"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "More than 10 tests a minute"
          }
        },
        "summary": "One minimal call to the candidate model provider of the requested slot.",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/system/logs": {
      "get": {
        "operationId": "list_logs",
        "parameters": [
          {
            "description": "How many lines to return, 1 to 2000. Default 200.",
            "in": "query",
            "name": "lines",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The least severe level to return: `error`, `warn`, `info`, `debug` or `trace`.",
            "in": "query",
            "name": "level",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LogLineDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The recent log lines"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Logs are not captured"
          }
        },
        "summary": "The hub's recent log lines, oldest first, with secrets removed.",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/system/update": {
      "get": {
        "operationId": "get_update",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateDto"
                }
              }
            },
            "description": "The last check and how to update"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          }
        },
        "summary": "The last release check, if the hub has made one.",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/system/update/check": {
      "post": {
        "operationId": "check_update",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateDto"
                }
              }
            },
            "description": "The new check"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Checked less than a minute ago"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "GitHub did not answer with a release"
          }
        },
        "summary": "Checks for a release now, at most once a minute.",
        "tags": [
          "system"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Healthy"
          }
        },
        "summary": "Liveness: `ok` while the hub serves requests.",
        "tags": [
          "system"
        ]
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Prometheus text format"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No session and no valid bearer token"
          }
        },
        "summary": "Prometheus metrics: readable by a logged-in session, or by a scraper holding the\nconfigured bearer token. Without either, 401.",
        "tags": [
          "system"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyzBody"
                }
              }
            },
            "description": "Ready"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyzBody"
                }
              }
            },
            "description": "Not ready; the body names the failing checks"
          }
        },
        "summary": "Readiness: 200 when the hub can do its job, 503 naming what it cannot.",
        "tags": [
          "system"
        ]
      }
    }
  },

              "$ref": "#/components/schemas/SummaryFieldDto"
            },
            "type": "array"
          },
          "history": {
            "description": "Every revision, oldest first; the newest 200 when there are more.",
            "items": {
              "$ref": "#/components/schemas/SummaryRevisionDto"
            },

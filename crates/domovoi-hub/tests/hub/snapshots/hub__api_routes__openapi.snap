          "id": {
            "description": "The key id: 16 lowercase hex characters.",
            "type": "string"
          },
          "label": {
            "description": "The owner's note about the key.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "PackageDetailDto": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PackageDto",
            "description": "The package."
          },
          {
            "properties": {
              "file_status": {
                "description": "`ready`, or `missing` when the archive file is not in the store and the package must\nbe imported again before it can be installed.",
                "type": "string"
              },
              "hosts": {
                "description": "The hosts known to have this version.",
                "items": {
                  "$ref": "#/components/schemas/PackageHostDto"
                },
                "type": "array"
              },
              "signature_toml": {
                "description": "The signature file's text, as imported.",
                "type": "string"
              }
            },
            "required": [
              "signature_toml",
              "hosts",
              "file_status"
            ],
            "type": "object"
          }
        ],
        "description": "One imported package with the hosts that have it."
      },
      "PackageDto": {
        "description": "One imported package.",
        "properties": {
          "already_imported": {
            "description": "True when an import found this exact archive already imported and changed nothing.",
            "type": "boolean"
          },
          "archive_sha256": {
            "description": "SHA-256 of the archive: 64 lowercase hex characters.",
            "type": "string"
          },
          "archive_size": {
            "description": "The archive's size in bytes.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "imported_at": {
            "description": "When it was imported.",
            "type": "string"
          },
          "key_id": {
            "description": "The key that signed it: 16 lowercase hex characters.",
            "type": "string"
          },
          "name": {
            "description": "The package name.",
            "type": "string"
          },
          "signer_label": {
            "description": "The label of the signing key in the hub's owner keys, if it has one.",
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "description": "Its version.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "archive_sha256",
          "key_id",
          "archive_size",
          "imported_at",
          "already_imported"
        ],
        "type": "object"
      },
      "PackageHostDto": {
        "description": "A host's copy of a package, as the hub last saw it.",
        "properties": {
          "host_id": {
            "description": "The host's id.",
            "type": "string"
          },
          "host_name": {
            "description": "The host's name.",
            "type": "string"
          },
          "observed_at": {
            "description": "When the hub saw it.",
            "type": "string"
          },
          "status": {
            "description": "`active`, `disabled_untrusted_key` or `missing_files`.",
            "type": "string"
          }
        },
        "required": [
          "host_id",
          "host_name",
          "status",
          "observed_at"
        ],
        "type": "object"
      },
      "PackageImportForm": {
        "description": "The form an import posts. Documents the request; the handler reads it field by field.",
        "properties": {
          "archive": {
            "description": "The `<name>-<version>.tar.zst` archive.",
            "format": "binary",
            "type": "string"
          },
          "signature": {
            "description": "The detached `.sig.toml` signature file.",
            "format": "binary",
            "type": "string"
          }
        },
        "required": [
          "archive",
          "signature"
        ],
        "type": "object"
      },
      "PackagesStatusDto": {
        "description": "What the hub holds, how it is limited and which keys it trusts.",
        "properties": {
          "approval_window_secs": {
            "description": "How long an approval to install stays valid.",
            "format": "int64",
            "type": "integer"
          },
          "artifact_count": {
            "description": "How many packages are imported.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "enabled": {
            "description": "Whether packages can be imported and installed.",
            "type": "boolean"
          },
          "max_artifact_bytes": {
            "description": "The largest archive accepted, in bytes.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "max_store_bytes": {
            "description": "The most bytes of archives the hub keeps.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "owner_keys": {
            "description": "The keys whose signatures the hub accepts.",
            "items": {
              "$ref": "#/components/schemas/OwnerKeyDto"
            },
            "type": "array"
          },
          "revoked": {
            "description": "Key ids that are never accepted.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "used_store_bytes": {
            "description": "Bytes of archives the hub holds now.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "max_artifact_bytes",
          "max_store_bytes",
          "used_store_bytes",
          "artifact_count",
          "owner_keys",
          "revoked",
          "approval_window_secs"
        ],
        "type": "object"
      },
      "ParamDto": {
        "description": "One declared skill parameter.",
        "properties": {
          "description": {
            "description": "What it means.",
            "type": "string"
          },
          "kind": {
            "description": "The type and its limits as JSON, for example `{\"type\":\"integer\",\"min\":1,\"max\":10}`."
          },
          "name": {
            "description": "Parameter name.",
            "type": "string"
          },
          "required": {
            "description": "Whether it must be given.",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "description",
          "required",
          "kind"
        ],
        "type": "object"
      },
      "PasswordRequest": {
        "description": "A command that needs the admin's password.",
        "properties": {
          "password": {
            "description": "The admin's password.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "PastOperationDto": {
        "description": "One finished operation, the shape every list of past operations shares.",
        "properties": {
          "contracts": {
            "description": "What was run.",
            "items": {
              "$ref": "#/components/schemas/ExecutedContractDto"
            },
            "type": "array"
          },
          "ended_at": {
            "description": "When it ended.",
            "type": "string"
          },
          "goal": {
            "description": "What it was for.",

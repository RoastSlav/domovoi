        "summary": "Asks the triage model a follow-up question about an incident. It uses read-only tools\nand never proposes actions.",
        "tags": [
          "incidents"
        ]
      }
    },
    "/api/v1/incidents/{id}/dismiss": {
      "post": {
        "operationId": "dismiss_incident",
        "parameters": [
          {
            "description": "Incident id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DismissRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Dismissed"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Empty reason, too long, too many minutes, or a target a rule cannot match"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No active incident"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not possible now"
          }
        },
        "summary": "Dismisses an incident as a known condition: closes it now with the verdict `EXPECTED`,\nand when `ignore_for_minutes` is given, creates the rule that keeps the check quiet\n(0 means always). The rule is stored before the incident closes, so a check firing in\nthe moment between the two is already silenced, and a dismiss that fails afterwards\nleaves a rule that a human can see and delete on the Known conditions page. The rule\nmatches the incident's host, check and target; `note` is the reason, so a human can\nread later what it covers. A target with `*` in it cannot be matched exactly by a rule\npattern, so dismissing such an incident with a period is refused.",
        "tags": [
          "incidents"
        ]
      }
    },
    "/api/v1/incidents/{id}/followups": {
      "get": {
        "operationId": "incident_followups",
        "parameters": [
          {
            "description": "Incident id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FollowUpsDto"
                }
              }
            },
            "description": "The remembered turns"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Malformed or unknown incident id"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Triage is off"
          }
        },
        "summary": "The questions and answers the model still remembers for an incident, oldest first.\nAnswers recorded before the last clear are not in the list. An id that parses but is\nnot a stored incident gets 404, so a cleared conversation is never read as a\nmistyped one.",
        "tags": [
          "incidents"
        ]
      }
    },
    "/api/v1/incidents/{id}/followups/clear": {
      "post": {
        "operationId": "clear_incident_followups",
        "parameters": [
          {
            "description": "Incident id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The conversation was forgotten"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such incident"
          }
        },
        "summary": "Forgets the conversation: the next question will not be shown the earlier ones. Works\nwhether triage is on or off, and on a resolved incident too; it writes one timeline\nline and publishes nothing.",
        "tags": [
          "incidents"
        ]
      }
    },

          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A kind that is too long"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          }
        },
        "summary": "Audit entries, newest first, with their hash.",
        "tags": [
          "audit"
        ]
      }
    },
    "/api/v1/audit/verification": {
      "get": {
        "operationId": "verify_audit",
        "parameters": [
          {
            "description": "`recent` (default) checks the newest entries;\n`full` checks everything.",

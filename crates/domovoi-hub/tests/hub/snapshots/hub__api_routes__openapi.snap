        "description": "How an operation unfolded, as a projection of its journal rows. Replay rebuilds past states\nfrom this and the operation's final trace.",
        "properties": {
          "as_of_seq": {
            "description": "The journal head read **before** the rows: rows with a larger `seq` are not included.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },

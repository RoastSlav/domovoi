              },
              {
                "type": "null"
              }
            ]
          },
          "timeline": {
            "description": "The timeline, oldest first.",
            "items": {
              "$ref": "#/components/schemas/TimelineEntryDto"
            },
            "type": "array"
          },
          "tools_used": {
            "description": "Skills and tools used while triaging or answering, in first-call order.",
            "items": {
              "$ref": "#/components/schemas/ToolUsageDto"
            },
            "type": "array"
          },
          "triage": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TriageStateDto",
                "description": "How the latest triage went, if it ran."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "incident",
          "host",
          "card",
          "timeline",
          "operations",
          "tools_used",
          "as_of_seq"
        ],
        "type": "object"
      },
      "IncidentGroupsDto": {

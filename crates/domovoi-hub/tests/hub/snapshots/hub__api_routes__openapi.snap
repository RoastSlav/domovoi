            "schema": {
              "type": "string"
            }
          },
          {
            "description": "How many lines to return, 1 to 2000. Default 200.",
            "in": "query",
            "name": "lines",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The least severe level to return: `error`, `warn`, `info`, `debug` or `trace`.",
            "in": "query",
            "name": "level",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {

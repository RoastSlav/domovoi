              "string",
              "null"
            ]
          },
          "message": {
            "description": "For `error`: what went wrong.",
            "type": [
              "string",
              "null"
            ]
          },
          "step": {
            "description": "For `outcome_unknown`: the Execution step whose result is not known.",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "`budget`, `outcome_unknown`, `global_pause` or `error`.",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "PauseRequest": {
        "description": "Pause autonomy.",
        "properties": {
          "reason": {
            "description": "Why, 1 to 280 characters.",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "PinDto": {
        "description": "The key the owner pinned.",
        "properties": {
          "fingerprint": {
            "description": "64 lowercase hex characters.",
            "type": "string"
          },
          "pinned_at": {
            "description": "When it was pinned.",
            "type": "string"
          },
          "pinned_by": {
            "description": "Who pinned it.",

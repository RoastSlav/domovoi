      "SkillDto": {
        "description": "A skill on a host.",
        "properties": {
          "applies_to": {
            "description": "Checks it is relevant to.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": {
            "description": "What it does.",
            "type": "string"
          },
          "enabled": {
            "description": "Whether the hub may run and suggest this skill on the host.",
            "type": "boolean"
          },
          "manifest_hash": {
            "description": "Hash of the full manifest the agent has, as hex.",
            "type": "string"
          },
          "name": {
            "description": "Skill name.",
            "type": "string"
          },
          "params": {
            "description": "Declared parameters.",
            "items": {
              "$ref": "#/components/schemas/ParamDto"
            },
            "type": "array"
          },
          "readme": {
            "description": "The skill folder's README.md, at most 8 KiB; absent when there is none.",
            "type": [
              "string",
              "null"
            ]
          },
          "risk": {
            "description": "`read`, `write` or `destructive`.",
            "type": "string"
          },
          "timeout_secs": {
            "description": "How long one run may take, in seconds.",
            "format": "int64",
            "type": "integer"
          },
          "verify": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/VerifyDto",
                "description": "How the hub verifies a write skill, when it declares one."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "description",
          "risk",
          "params",
          "applies_to",
          "timeout_secs",
          "manifest_hash",
          "enabled"
        ],
        "type": "object"
      },
      "SkillEnabledUpdate": {
        "description": "Turning one host skill on or off.",
        "properties": {
          "enabled": {
            "description": "Whether the hub may run and suggest the skill on this host.",
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "type": "object"
      },
      "SkippedFileDto": {
        "description": "A file a notes import left out.",
        "properties": {
          "name": {
            "description": "The file name as uploaded.",
            "type": "string"
          },
          "reason": {
            "description": "Why it was left out.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "reason"
        ],
        "type": "object"
      },
      "TestRequest": {
        "description": "Candidate values for a connection test; nothing is saved.",
        "properties": {
          "changes": {
            "description": "The same shape as a save; a secret left as `{ \"keep\": true }` uses the stored one.",
            "type": "object"
          },
          "slot": {
            "description": "Which provider to test or list models for: `\"primary\"` (the default) or\n`\"secondary\"`. Other tests ignore it.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "TestResultDto": {
        "description": "The result of a connection test.",
        "properties": {
          "latency_ms": {
            "description": "How long it took, in milliseconds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "message": {
            "description": "What happened, in one line.",
            "type": "string"
          },
          "ok": {
            "description": "Whether it worked.",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "message",
          "latency_ms"
        ],
        "type": "object"
      },
      "TimelineEntryDto": {
        "description": "One timeline line.",
        "properties": {
          "at": {
            "description": "When.",
            "type": "string"
          },
          "kind": {
            "description": "What kind, for example `incident.opened` or `triage.report`.",
            "type": "string"
          },
          "summary": {
            "description": "One line.",
            "type": "string"
          }
        },
        "required": [
          "at",
          "kind",
          "summary"
        ],
        "type": "object"
      },
      "ToolUsageDto": {
        "description": "One skill or tool used while triaging or answering a follow-up.",
        "properties": {
          "calls": {
            "description": "How many times it was called.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "failures": {
            "description": "How many of those calls failed.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "description": "`tool` or `skill`.",
            "type": "string"
          },
          "last_used": {
            "description": "When it was last called.",
            "type": "string"
          },
          "name": {
            "description": "The tool name, or the skill name for a read skill.",
            "type": "string"
          },
          "refused": {
            "description": "How many of those calls were not run because the tool-call budget was spent.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "kind",
          "calls",
          "failures",
          "refused",
          "last_used"
        ],
        "type": "object"
      },
      "TriageSettings": {
        "description": "Triage limits.",
        "properties": {
          "concurrency": {
            "description": "Runs at the same time.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "enabled": {
            "description": "Whether new incidents are triaged.",
            "type": "boolean"
          },
          "monthly_budget_usd": {
            "description": "Monthly spending cap in US dollars, if set.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "per_hour_runs": {
            "description": "Runs per hour at most.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "concurrency",
          "per_hour_runs"
        ],
        "type": "object"
      },
      "TriageStateDto": {
        "description": "How triage went for an incident.",
        "properties": {
          "kind": {
            "description": "`report`, `cached`, `skipped` or `failed`.",
            "type": "string"
          },
          "reason": {
            "description": "Why it was skipped or failed.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "TurnDto": {
        "description": "One question and its answer of the conversation the model still remembers.",
        "properties": {
          "answer": {
            "description": "What the model answered.",
            "type": "string"
          },
          "asked_by": {
            "description": "Who asked, as `user:` and its user id.",
            "type": "string"
          },
          "at": {
            "description": "When the answer was recorded, RFC 3339.",
            "type": "string"
          },
          "question": {
            "description": "What the operator asked.",
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer",
          "asked_by",
          "at"
        ],
        "type": "object"
      },
      "UiEvent": {
        "description": "A change the web UI should show, sent on the event stream.",
        "properties": {
          "action_id": {
            "description": "The action concerned, for action events.",
            "type": [
              "string",
              "null"
            ]
          },
          "event": {
            "description": "What happened, for example `incident_opened` or `action_changed`.",
            "type": "string"
          },
          "incident_id": {
            "description": "The incident concerned.",
            "type": "string"
          },
          "kind": {
            "description": "`incident` or `action`.",
            "type": "string"
          },
          "status": {
            "description": "The new status name, when it changed.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "event",
          "incident_id"
        ],
        "type": "object"
      },
      "UpdateDto": {
        "description": "The newest release this hub knows about, with commands ready to copy.",
        "properties": {
          "agent_command": {
            "description": "Reinstalls an agent and restarts its service.",
            "type": [
              "string",
              "null"
            ]
          },
          "checked_at": {
            "description": "When this hub last checked.",
            "type": [
              "string",
              "null"
            ]
          },
          "current": {
            "description": "The version this hub runs.",
            "type": "string"
          },
          "docker_command": {
            "description": "Pulls and recreates a container deployment.",
            "type": [
              "string",
              "null"
            ]
          },
          "hub_command": {
            "description": "Reinstalls the hub and restarts its service.",
            "type": [
              "string",
              "null"
            ]
          },
          "latest": {
            "description": "The release's tag, for example `v0.5.0`; `None` until the first check succeeds.",
            "type": [
              "string",
              "null"
            ]
          },
          "newer": {
            "description": "Whether `latest` is newer than `current`.",
            "type": "boolean"
          },
          "notes": {
            "description": "The release notes, cut to 4000 characters.",
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "description": "When the release was published.",
            "type": [
              "string",
              "null"
            ]
          },
          "upgrade_command": {
            "description": "Replaces the hub's binary in place and restarts its service. `None` when the hub\nruns in a container, where the image is what changes.",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "description": "The release's page on GitHub.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "current",
          "newer"
        ],
        "type": "object"
      },
      "UsageSettings": {
        "description": "Model usage this calendar month (UTC).",
        "properties": {
          "cost_usd": {
            "description": "Cost in US dollars, as far as prices are configured.",
            "format": "double",
            "type": "number"
          },
          "tokens_in": {
            "description": "Prompt tokens.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "tokens_out": {
            "description": "Generated tokens.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "tokens_in",
          "tokens_out",
          "cost_usd"
        ],
        "type": "object"
      },
      "UserDto": {
        "description": "The logged-in user.",
        "properties": {
          "id": {
            "description": "User id.",
            "type": "string"
          },
          "username": {
            "description": "Login name.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ],
        "type": "object"
      },
      "VerifyDto": {
        "description": "How the hub checks that a write skill worked.",
        "properties": {
          "delay_secs": {
            "description": "How long to wait before re-running it, in seconds.",
            "format": "int64",
            "type": "integer"
          },
          "recheck": {
            "description": "Whether the hub re-runs the originating check.",
            "type": "boolean"
          }
        },
        "required": [
          "recheck",
          "delay_secs"
        ],
        "type": "object"
      },
      "WebhookSettings": {
        "description": "One inbound webhook.",
        "properties": {
          "auth": {
            "description": "`hmac` or `bearer`.",
            "type": "string"
          },
          "default_host": {
            "description": "The host used when the payload names none.",
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "description": "`generic`, `alertmanager` or `uptime_kuma`.",
            "type": "string"
          },
          "name": {
            "description": "The name in its URL.",
            "type": "string"
          },
          "secret": {
            "description": "`[set]` or `[unset]`.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "auth",
          "secret"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "domovoi_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The hub's JSON API. Log in with `POST /api/v1/auth/login`; the session is a cookie. Send the session's `csrf_token` as `X-CSRF-Token` on every unsafe request.",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "Domovoi hub API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ack-rules": {
      "get": {
        "operationId": "list_ack_rules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AckRuleDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every rule, soonest expiry first; rules that never expire come last"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          }
        },
        "summary": "Every rule, expired ones included. Rules that never expire come last.",
        "tags": [
          "incidents"
        ]
      },
      "post": {
        "operationId": "create_ack_rule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AckRuleInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AckRuleDto"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid rule"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          }
        },
        "summary": "Creates a rule.",
        "tags": [
          "incidents"
        ]
      }
    },
    "/api/v1/ack-rules/{id}": {
      "delete": {
        "operationId": "delete_ack_rule",
        "parameters": [
          {
            "description": "Rule id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such rule"
          }
        },
        "summary": "Deletes a rule.",
        "tags": [
          "incidents"
        ]
      }
    },
    "/api/v1/actions": {
      "get": {
        "operationId": "list_actions",
        "parameters": [
          {
            "description": "Only this status name, for example `proposed`.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only actions on this host, by name.",
            "in": "query",
            "name": "host",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The `next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size, 1 to 200. Default 50.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionPage"
                }
              }
            },
            "description": "One page"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unknown status"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such host"
          }
        },
        "summary": "Actions, newest first.",
        "tags": [
          "actions"
        ]
      }
    },
    "/api/v1/actions/{id}/approve": {
      "post": {
        "operationId": "approve_action",
        "parameters": [
          {
            "description": "Action id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionDto"
                }
              }
            },
            "description": "Approved; it runs next"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Destructive without the typed confirmation"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such action"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not proposed any more, or expired"
          }
        },
        "summary": "Approves a proposed action. Destructive skills need `confirm_text` equal to the skill's\nname; chat buttons can never approve them.",
        "tags": [
          "actions"
        ]
      }
    },
    "/api/v1/actions/{id}/deny": {
      "post": {
        "operationId": "deny_action",
        "parameters": [
          {
            "description": "Action id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionDto"
                }
              }
            },
            "description": "Denied"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such action"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not proposed any more"
          }
        },
        "summary": "Denies a proposed action.",
        "tags": [
          "actions"
        ]
      }
    },
    "/api/v1/advisories": {
      "get": {
        "operationId": "list_advisories",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdvisoryDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Open advisories"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          }
        },
        "summary": "Open advisories, newest first.",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            },
            "description": "Logged in; the cookie is set"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Wrong username or password"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many attempts"
          }
        },
        "summary": "Logs in and sets the session cookie. Five failures a minute from one address lock it\nout for a while.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Logged out"
          }
        },
        "summary": "Ends the session and clears the cookie.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            },
            "description": "Account created and logged in"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid username or password"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Wrong, used or expired token"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Setup is closed"
          }
        },
        "summary": "Creates the admin account with the one-time token from the setup link, and logs in.\nOnly works before the first user exists.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/chat": {
      "post": {
        "operationId": "chat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "The answer"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The question or a turn is empty or too long"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such host"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Triage is off, the monthly model budget is spent, or the model is unavailable"
          }
        },
        "summary": "Answers a general question about the operator's hosts. With a connected `host` the model\nmay use that host's read-only tools and read skills; without one, or with an offline host,\nit answers from an overview and calls no tools. It never proposes or runs actions.",
        "tags": [
          "hosts"
        ]
      }
    },

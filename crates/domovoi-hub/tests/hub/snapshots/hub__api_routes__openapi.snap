          "host_id",
          "outcome"
        ],
        "type": "object"
      },
      "ExecutionDto": {
        "description": "A run of a capability that a person approves or denies.",
        "properties": {
          "approval_step": {
            "description": "The Approval step that waits for a person.",
            "type": [
              "string",
              "null"
            ]
          },
          "approved_at": {
            "description": "When it was approved.",
            "type": [
              "string",
              "null"
            ]
          },
          "approved_by": {
            "description": "Who approved it, for example `user:<id>`.",
            "type": [
              "string",
              "null"
            ]
          },
          "args": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Arguments by parameter name.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "authorization": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AuthorizationDto",
                "description": "Who authorized it, once somebody or a policy did."
              },
              {
                "type": "null"
              }
            ]
          },
          "check": {
            "description": "The check it is about.",
            "type": "string"
          },
          "confirm_required": {
            "description": "Whether approving needs the skill's name typed: for a destructive skill, and for one\nwhose risk is not known.",
            "type": "boolean"
          },
          "contract": {
            "description": "The contract, for example `skill.restart_container`.",
            "type": "string"
          },
          "contract_version": {
            "description": "The contract version the plan was made against.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "expires_at": {
            "description": "When the approval window closes.",
            "type": "string"
          },
          "host_id": {
            "description": "The host it runs on.",
            "type": "string"
          },
          "plan_hash": {
            "description": "The plan hash a person approves, 64 hex characters.",
            "type": "string"
          },
          "reason": {
            "description": "Why it was refused, not run, unavailable or failed.",
            "type": [
              "string",
              "null"
            ]
          },
          "risk": {
            "description": "`read`, `write` or `destructive` from the host's current skills; `null` when the\nskill is not on the host now.",
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "description": "The derived state, for example `awaiting_approval` or `succeeded`.",
            "type": "string"
          },
          "step": {
            "description": "The Execution step id, which is also the execution id.",
            "type": "string"
          },
          "target": {
            "description": "The target it is about.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "step",
          "contract",
          "contract_version",
          "host_id",
          "check",
          "args",
          "state",
          "plan_hash",
          "confirm_required",
          "expires_at"
        ],
        "type": "object"
      },
      "ExperienceItemDto": {
        "description": "One search hit.",

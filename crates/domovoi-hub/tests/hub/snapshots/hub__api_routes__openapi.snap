              "string",
              "null"
            ]
          },
          "from": {
            "description": "The source end; `null` once the retention purge cleared it.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Relation id.",
            "type": "string"
          },
          "kind": {
            "description": "What the edge means.",
            "type": "string"
          },
          "observed_at": {
            "description": "When it was last seen to hold.",

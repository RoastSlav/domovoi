          },
          "operation_id": {
            "description": "Operation id.",
            "type": "string"
          },
          "state": {
            "description": "`not_ready` while the operation is open, `drafting` once it has finished and has no\nsummary yet, `ready` after.",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "as_of_seq",
          "state",
          "fields",
          "history",
          "history_truncated",
          "label"
        ],
        "type": "object"
      },

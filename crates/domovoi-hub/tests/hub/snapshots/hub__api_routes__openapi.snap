          }
        },
        "summary": "Sends today's digest now.",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/events": {
      "get": {
        "description": "Frames: `ready` (`head_seq`, `resumed`, `topics`), `journal` (one row; its `id` is the journal\n`seq`), `reset` (`reason` is `pruned`, `ahead` or `lagged`: refetch what you hold). A client\nthat reconnects sends `Last-Event-ID` (or `after`) and receives every matching row after it.\nAn idle stream sends a `: keepalive` comment every 15 seconds.\n\nA connection that follows `conversations:<uuid>` also receives the ephemeral `live.start`,\n`live.text`, `live.tool` and `live.end` events of an answer being written. They carry no `id`,\nare never replayed and may be dropped when a client is slow; the committed message arrives as\na `journal` frame.",
        "operationId": "stream_events",
        "parameters": [
          {
            "description": "Comma-separated topics: `incidents`, `approvals`, `operations`, `operation:<id>`,\n`hosts`, `conversations:<id>`. At most 16. Absent means `incidents,approvals,operations`.",
            "in": "query",
            "name": "topics",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Resume after this journal `seq`. The `Last-Event-ID` header wins when both are given.",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "An event stream"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "An unknown topic or a malformed position"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many open event streams"
          }
        },
        "summary": "Committed journal rows as server-sent events.",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/experience/search": {
      "get": {
        "operationId": "search_experience_owner",
        "parameters": [
          {
            "description": "What to look for, at most 200 characters; empty lists the newest operations.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`host` (default) or `global`.",
            "in": "query",
            "name": "scope",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The host's name, required for scope `host`.",
            "in": "query",
            "name": "host",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "How many to return, 1 to 50. Default 10.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceSearchDto"
                }
              }
            },
            "description": "The matches"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A bad scope, a missing host or a query that is too long"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such host"
          }
        },
        "summary": "Searches finished operations. One host by default; every host only when asked.",
        "tags": [
          "experience"
        ]
      }
    },

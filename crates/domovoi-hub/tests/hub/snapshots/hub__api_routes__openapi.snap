      "HistoryEventDto": {
        "description": "One journal row of the operation, reduced to what replay needs. It never carries intent,\nsummary, reason, output or any free text.",
        "properties": {
          "at": {
            "description": "When the row was recorded: RFC 3339 UTC with a trailing `Z`.",

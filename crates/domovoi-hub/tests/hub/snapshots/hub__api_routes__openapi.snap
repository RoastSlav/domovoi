          "check"
        ],
        "type": "object"
      },
      "PlanRequestDto": {
        "additionalProperties": false,
        "description": "Plan a job: what it would do on each host, without doing anything.",
        "properties": {
          "host_ids": {
            "description": "One to sixteen host ids, each once.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "kind": {
            "description": "`install` or `uninstall`.",
            "type": "string"
          },
          "name": {
            "description": "The package name.",
            "type": "string"
          },
          "version": {
            "description": "The package version.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "version",
          "host_ids"
        ],
        "type": "object"
      },
      "PlanTargetDto": {
        "description": "What would happen on one host.",
        "properties": {
          "availability": {
            "description": "The state of the capability on this host, such as `available` or `host_absent`.",
            "type": "string"
          },
          "availability_reason": {
            "description": "The reason code of a refused state, when there is one.",
            "type": [
              "string",
              "null"
            ]
          },
          "availability_text": {
            "description": "The sentence that explains the state.",
            "type": "string"
          },
          "host_id": {
            "description": "The host's id.",
            "type": "string"
          },
          "host_name": {
            "description": "The host's name.",
            "type": "string"
          },
          "installed": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/HostPackageDto",
                "description": "What the hub last saw of this package on the host."
              },
              {
                "type": "null"
              }
            ]
          },
          "plan_hash": {
            "description": "What approval of this host's work binds: 64 lowercase hex characters.",
            "type": "string"
          },
          "warnings": {
            "description": "Things the owner should know before approving.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "host_id",
          "host_name",
          "plan_hash",
          "availability",
          "availability_text",
          "warnings"
        ],
        "type": "object"
      },
      "PolicyAllowDto": {
        "description": "The policy decision that allowed an execution: shown to the owner, never accepted from a client.",
        "properties": {
          "decision_id": {
            "description": "The decision the permit packs.",
            "type": "string"
          },
          "policy_version": {
            "description": "The policy version the decision used.",
            "type": "string"
          },
          "rules": {
            "description": "The rules the decision applied.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "decision_id",
          "rules",
          "policy_version"
        ],
        "type": "object"
      },
      "PolicyCapabilityDto": {
        "description": "The capability dimension of a rule.",
        "oneOf": [
          {
            "description": "Every capability.",

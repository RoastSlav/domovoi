              "string",
              "null"
            ]
          },
          "state": {
            "description": "`open`, `blocked_leak`, `blocked_untested` or `unknown` before a refresh.",
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "HeadDto": {
        "description": "The newest stored entry's position.",

          },
          "hosts": {
            "description": "The hosts involved.",
            "items": {
              "$ref": "#/components/schemas/HostRefDto"
            },
            "type": "array"
          },
          "narrative": {
            "description": "`problem`, `cause` and `fix`: only those that exist, each with its source.",
            "items": {
              "$ref": "#/components/schemas/SummaryFieldDto"
            },
            "type": "array"
          },
          "operation_id": {
            "description": "Operation id.",
            "type": "string"
          },
          "outcome": {
            "description": "`succeeded`, `failed`, `escalated` or `cancelled`.",
            "type": "string"
          },
          "verified": {
            "description": "Whether the fix was verified.",
            "type": "boolean"
          }
        },
        "required": [
          "operation_id",
          "goal",
          "ended_at",
          "outcome",
          "verified",
          "hosts",
          "contracts",
          "narrative"
        ],
        "type": "object"
      },
      "PathConfirmationDto": {
        "description": "The confirmation of a management path. The helper's evidence is not returned.",
        "properties": {
          "confirmed_at": {
            "description": "When.",
            "type": "string"
          },
          "confirmed_by": {
            "description": "Who confirmed it.",
            "type": "string"
          }
        },
        "required": [
          "confirmed_by",
          "confirmed_at"
        ],
        "type": "object"
      },
      "PauseReasonDto": {
        "description": "Why an operation is paused.",
        "properties": {
          "exhausted": {
            "description": "For `budget`: the limit that ran out.",

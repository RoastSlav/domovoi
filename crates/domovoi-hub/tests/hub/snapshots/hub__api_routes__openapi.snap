        "required": [
          "value",
          "expected_revision"
        ],
        "type": "object"
      },
      "EditSummaryResponse": {
        "description": "The result of an edit.",
        "properties": {
          "field": {
            "$ref": "#/components/schemas/SummaryFieldDto",

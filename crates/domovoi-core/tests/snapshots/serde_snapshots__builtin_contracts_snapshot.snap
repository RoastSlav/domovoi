    "category": "disk.observe",
    "constrainable_args": [],
    "description": "Show SMART health attributes for one disk.",
    "effect": "read",
    "execution": "agent",
    "id": "disk.smart_report",
    "idempotency": "idempotent",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "description": "Disk device, for example /dev/sda.",
          "maxLength": 64,
          "pattern": "^/dev/",
          "type": "string"
        }
      },
      "required": [

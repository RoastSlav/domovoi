{
  "container.events": {
    "category": "container.observe",
    "constrainable_args": [],
    "description": "Show recent Docker events, optionally for one container.",
    "effect": "read",
    "execution": "agent",
    "id": "container.events",
    "idempotency": "idempotent",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "container": {
          "description": "Only events for this container.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "since_minutes": {
          "default": 60,
          "description": "How many minutes back to look.",
          "maximum": 1440,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "output_limit_bytes": 8192,
    "reversibility": "not_applicable",
    "safety_facts": [],
    "source": {
      "kind": "built_in"
    },
    "target_arg": null,
    "target_kind": "host",
    "timeout": "15s",
    "title": "Docker events",
    "verification": {
      "kind": "none"
    },
    "version": 1
  },

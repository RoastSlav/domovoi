  "system.journal": {
    "category": "host.observe",
    "constrainable_args": [],
    "description": "Read recent systemd journal lines, optionally for one unit or one priority (priority err for errors only); lines sets how many.",
    "effect": "read",
    "execution": "agent",
    "id": "system.journal",
    "idempotency": "idempotent",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "kernel": {
          "default": false,
          "description": "Kernel messages only.",
          "type": "boolean"
        },
        "lines": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "priority": {
          "description": "Only lines of this priority or worse (for errors use err). Leave out for every priority.",
          "enum": [
            "emerg",
            "alert",
            "crit",
            "err",
            "warning",
            "notice",
            "info",
            "debug"
          ],
          "type": "string"
        },
        "since_minutes": {
          "default": 60,
          "description": "How many minutes back to look.",
          "maximum": 1440,
          "minimum": 1,
          "type": "integer"
        },
        "unit": {
          "description": "Only lines from this systemd unit.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "output_limit_bytes": 8192,
    "reversibility": "not_applicable",
    "safety_facts": [],
    "source": {
      "kind": "built_in"
    },
    "target_arg": null,
    "target_kind": "host",
    "timeout": "15s",
    "title": "Journal",
    "verification": {
      "kind": "none"
    },
    "version": 1
  }

---
source: crates/domovoi-config/tests/config/schema.rs
expression: "AgentConfig::json_schema()"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentConfig",
  "description": "The whole of `agent.toml`. Only `[agent]` is required.",
  "type": "object",
  "properties": {
    "agent": {
      "description": "Identity of this agent and where it connects.",
      "$ref": "#/$defs/AgentSection"
    },
    "checks": {
      "description": "Per-check settings, keyed by check key such as `disk.free`.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CheckConfig"
      },
      "propertyNames": {
        "description": "A dotted check key such as `disk.free`.",
        "type": "string",
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+){0,7}$"
      }
    },
    "containers": {
      "description": "Container baselines.",
      "$ref": "#/$defs/ContainersSection"
    },
    "docker": {
      "description": "The Docker integration.",
      "$ref": "#/$defs/DockerSection"
    },
    "local_webhooks": {
      "description": "A local listener for webhooks from services on this host. Omit to disable.",
      "anyOf": [
        {
          "$ref": "#/$defs/LocalWebhooks"
        },
        {
          "type": "null"
        }
      ]
    },
    "packages": {
      "description": "Package installation. Omit to disable: nothing is installed or advertised.",
      "anyOf": [
        {
          "$ref": "#/$defs/PackagesSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "description": "What skills this agent is willing to run.",
      "$ref": "#/$defs/PolicySection"
    },
    "unattended": {
      "description": "The ceiling on what a policy-labelled request may do. Omit to accept none.",
      "anyOf": [
        {
          "$ref": "#/$defs/UnattendedSection"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "agent"
  ],
  "$defs": {
    "AgentSection": {
      "description": "`[agent]`.",
      "type": "object",
      "properties": {
        "host_name": {
          "description": "This host's name as shown in Domovoi.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "host_root": {
          "description": "Where the host filesystem is mounted; `/host` when running in a container.\nDefault `/`.",
          "type": "string",
          "default": "/"
        },
        "hub_url": {
          "description": "The hub's agent server, such as `wss://hub.example.net:7421`. Must use `wss`.",
          "type": "string",
          "format": "uri"
        },
        "in_container": {
          "description": "Says whether the agent runs in a container, instead of letting it guess. It wins over\nthe detection (`/.dockerenv`, cgroup names, `host_root`). Also set with\n`DOMOVOI_AGENT__IN_CONTAINER=true` or `false`. Unset: detect.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "mutation_limits": {
          "description": "How many mutating capability executions this agent accepts. Local and root-owned;\nthe hub cannot send, widen or override it.",
          "$ref": "#/$defs/MutationLimits"
        },
        "packages_dir": {
          "description": "Where installed packages live. Must be absolute. Default `/var/lib/domovoi-packages`.",
          "type": "string",
          "default": "/var/lib/domovoi-packages"
        },
        "skills_dir": {
          "description": "Where skill manifests are read from. Default `/etc/domovoi/skills`.",
          "type": "string",
          "default": "/etc/domovoi/skills"
        },
        "state_dir": {
          "description": "Where the agent keeps its key and spool. Default `/var/lib/domovoi-agent`.",
          "type": "string",
          "default": "/var/lib/domovoi-agent"
        }
      },
      "additionalProperties": false,
      "required": [
        "host_name",
        "hub_url"
      ]
    },
    "CheckConfig": {
      "description": "`[checks.<check_key>]`.",
      "type": "object",
      "properties": {
        "criticality": {
          "description": "Overrides how bad a failure is. Default: decided by the check.",
          "type": "string",
          "default": null,
          "enum": [
            "critical",
            "warning"
          ]
        },
        "enabled": {
          "description": "Whether the check runs. Default `true`.",
          "type": "boolean",
          "default": true
        },
        "interval": {
          "description": "How often it runs. Default: the check's own interval.",
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "thresholds": {
          "description": "Check-specific thresholds; each check documents its keys.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "ContainersSection": {
      "description": "`[containers]`.",
      "type": "object",
      "properties": {
        "baseline_expiry": {
          "description": "A container gone this long is dropped from the baseline. Default `\"7d\"`.",
          "$ref": "#/$defs/Duration"
        },
        "critical": {
          "description": "Container names whose absence is critical.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "ignore": {
          "description": "Container names never checked.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DockerMode": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "auto"
          ]
        }
      ]
    },
    "DockerSection": {
      "description": "`[docker]`: the container runtime integration. It speaks the Docker Engine API, which\nDocker, Podman and compatible engines answer.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "`\"auto\"`, `true` or `false`. `\"auto\"` (the default) uses an engine that answers on\nthe usual sockets and lets the hub switch it on or off for this host; `true` and\n`false` fix the choice here and the hub cannot change it.",
          "$ref": "#/$defs/DockerMode"
        },
        "endpoint": {
          "description": "`unix:///path/to/engine.sock` or `tcp://host:port` (for a socket proxy). Default:\nthe first of Docker's socket, rootless Docker's, Podman's and rootless Podman's that\nanswers.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Duration": {
      "description": "A positive duration such as \"30s\", \"5m\", \"24h\", \"7d\" or \"1h30m\".",
      "type": "string"
    },
    "LocalWebhooks": {
      "description": "`[local_webhooks]`.",
      "type": "object",
      "properties": {
        "allow_non_loopback": {
          "description": "Allow a `bind` address other than loopback. Default false: services on this host\nreach the relay, and nothing else does.",
          "type": "boolean",
          "default": false
        },
        "bind": {
          "description": "Listen address. Default `127.0.0.1:7422`.",
          "type": "string",
          "default": "127.0.0.1:7422"
        },
        "token": {
          "description": "A bearer token callers must send. Optional.",
          "anyOf": [
            {
              "$ref": "#/$defs/Secret"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "MutationLimits": {
      "description": "`[mutation_limits]`: the agent-side cap on mutating capability executions.\n\nSeparate from the unattended ceiling and from `[policy] allow_risk`: it limits how often a\nmutation may run, not what may run or who may approve it.",
      "type": "object",
      "properties": {
        "per_capability": {
          "description": "Per-contract per-hour limits, keyed by contract id; `0` blocks that contract.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "default": {}
        },
        "per_hour": {
          "description": "Mutating executions per rolling hour. Default 30; `0` blocks every mutation.",
          "type": "integer",
          "format": "uint32",
          "default": 30,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "PackageLimits": {
      "description": "`[packages.limits]`.",
      "type": "object",
      "properties": {
        "compressed_bytes": {
          "description": "Largest archive received, in bytes. 1 KiB to 256 MiB; default 20 MiB.",
          "type": "integer",
          "format": "uint64",
          "default": 20971520,
          "minimum": 0
        },
        "entries": {
          "description": "Most entries in an archive. 1 to 20000; default 2000.",
          "type": "integer",
          "format": "uint32",
          "default": 2000,
          "minimum": 0
        },
        "extraction_time": {
          "description": "Longest time unpacking may take. 1 second to 15 minutes; default 60 seconds.",
          "$ref": "#/$defs/Duration"
        },
        "file_bytes": {
          "description": "Largest single file, in bytes. At least 1, at most `uncompressed_bytes`; default 20 MiB.",
          "type": "integer",
          "format": "uint64",
          "default": 20971520,
          "minimum": 0
        },
        "path_bytes": {
          "description": "Longest path, in bytes. 16 to 1024; default 255.",
          "type": "integer",
          "format": "uint32",
          "default": 255,
          "minimum": 0
        },
        "path_depth": {
          "description": "Deepest path, counting the package directory. 2 to 32; default 8.",
          "type": "integer",
          "format": "uint32",
          "default": 8,
          "minimum": 0
        },
        "uncompressed_bytes": {
          "description": "Most bytes of file content in an archive. 1 KiB to 1 GiB; default 100 MiB.",
          "type": "integer",
          "format": "uint64",
          "default": 104857600,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "PackagesSection": {
      "description": "`[packages]`. Absent means this agent installs nothing and advertises nothing.",
      "type": "object",
      "properties": {
        "allow_install": {
          "description": "Whether the hub may ask this agent to install or remove packages. Default false;\nlisting installed packages is allowed either way.",
          "type": "boolean",
          "default": false
        },
        "limits": {
          "description": "Size and time caps applied while receiving and unpacking a package.",
          "$ref": "#/$defs/PackageLimits"
        },
        "revoked": {
          "description": "Key ids (16 lowercase hex characters) that are never trusted, even when also listed\nin `trusted_keys`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "trusted_keys": {
          "description": "Keys whose signatures this agent accepts. Read at start; the hub cannot change them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrustedKey"
          }
        }
      },
      "additionalProperties": false
    },
    "PolicySection": {
      "description": "`[policy]`.",
      "type": "object",
      "properties": {
        "allow_risk": {
          "description": "Risk classes of skills this agent runs. Default `[\"read\", \"write\"]`; add\n`\"destructive\"` to opt in.",
          "type": "array",
          "default": [
            "read",
            "write"
          ],
          "items": {
            "description": "What a skill may do: read, write or destructive.",
            "type": "string",
            "enum": [
              "read",
              "write",
              "destructive"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "Secret": {
      "description": "A secret read from an environment variable or a file; never written inline.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "env": {
              "description": "Name of the environment variable holding the value.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "env"
          ]
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "description": "Path of a file, readable only by its owner, holding the value.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "file"
          ]
        }
      ]
    },
    "TrustedKey": {
      "description": "One key entry: `[[packages.trusted_keys]]` in `agent.toml`, `[[packages.owner_keys]]` in `hub.toml`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The key id: the first 16 hex characters of the SHA-256 of the raw public key.",
          "type": "string"
        },
        "label": {
          "description": "A note for people, at most 64 characters.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "public_key": {
          "description": "The Ed25519 public key, 32 bytes in standard padded base64.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "public_key"
      ]
    },
    "UnattendedAllow": {
      "description": "One `[[unattended.allow]]` entry.",
      "type": "object",
      "properties": {
        "args": {
          "description": "Constrained argument values (`firewall.block_source`: `prefix_len_v4` and\n`prefix_len_v6`, one shortest allowed prefix length each). Not accepted for\n`unit.restart`.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": null
        },
        "capability": {
          "description": "The exact contract id, such as `unit.restart`. No wildcard.",
          "type": "string"
        },
        "max_active": {
          "description": "For contracts that bound concurrent runs (`firewall.block_source`: blocks held at\nonce, 1 to 10000). Not accepted for `unit.restart`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "max_per_hour": {
          "description": "How many policy-labelled executions of this contract per rolling hour. At least 1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_ttl": {
          "description": "For contracts that bound a lifetime (`firewall.block_source`: above 30 seconds, at\nmost 365 days). Not accepted for `unit.restart`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "targets": {
          "description": "Canonical targets: unit ids for `unit.restart`, `ipnet:<canonical network>` for\n`firewall.block_source`. `\"*\"` must be written explicitly.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "targets",
        "max_per_hour"
      ]
    },
    "UnattendedSection": {
      "description": "`[unattended]`. With no section, no `policy`-labelled request is accepted.",
      "type": "object",
      "properties": {
        "allow": {
          "description": "What may run unattended, one entry per contract.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnattendedAllow"
          }
        },
        "enabled": {
          "description": "Master switch. When `false` every policy-labelled request is refused.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    }
  }
}

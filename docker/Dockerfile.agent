# The agent image, built by the release workflow from the same prebuilt static binaries
# (dist/bin-amd64/domovoi and dist/bin-arm64/domovoi). Alpine rather than distroless,
# because the agent's checks call smartctl and lsblk.
#
# It runs as root inside the container. What it can see of the host is decided by the
# mounts: see deploy/compose/agent.yml.
FROM alpine:3.22

RUN apk add --no-cache ca-certificates smartmontools util-linux

ARG TARGETARCH
COPY --chmod=0755 dist/bin-${TARGETARCH}/domovoi /usr/local/bin/domovoi

LABEL org.opencontainers.image.title="Domovoi agent" \
      org.opencontainers.image.description="The Domovoi agent, for hosts that run everything in containers" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"

# `agent enroll` writes agent.toml here, next to the agent's key, so the volume keeps both.
ENV DOMOVOI_AGENT_CONFIG=/var/lib/domovoi-agent/agent.toml
VOLUME /var/lib/domovoi-agent
ENTRYPOINT ["/usr/local/bin/domovoi"]
CMD ["agent", "run"]
